                            <ComboBox ItemsSource="{Binding UpdateRates}" SelectedItem="{Binding UpdateRate}"/>
                            <TextBlock Margin="0,14,0,4" Text="Power profile" Style="{StaticResource EyebrowText}"/>
                            <ComboBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding PerformanceMode}"/>
