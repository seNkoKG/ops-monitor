<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:OpsMonitor.Studio.Models">

    <Style x:Key="SettingRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,13"/>
    </Style>

    <Style x:Key="MiniMetric" TargetType="Border" BasedOn="{StaticResource InsetBorder}">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style x:Key="SmallProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Height="{TemplateBinding Height}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Track" CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SceneCardTemplate" DataType="{x:Type models:SceneItem}">
        <Border Style="{StaticResource InsetBorder}" Margin="0,0,10,10" Width="210">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Style="{StaticResource TagBorder}">
                        <TextBlock Text="{Binding Layout}" Style="{StaticResource CaptionText}"/>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,10"
                           Text="{Binding Description}"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           TextTrimming="None"/>
                <TextBlock Grid.Row="2" Text="{Binding Hotkey}" Style="{StaticResource CaptionText}" FontFamily="{StaticResource Font.Mono}"/>
                <Button Grid.Row="3"
                        Margin="0,12,0,0"
                        Command="{Binding DataContext.ActivateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Content="Make active"
                        Style="{StaticResource StudioButton}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="AlertCardTemplate" DataType="{x:Type models:AlertRuleItem}">
        <Border Style="{StaticResource InsetBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{Binding SeverityBrush}" CornerRadius="3"/>
                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionText}">
                        <Run Text="{Binding Metric, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding Condition, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Threshold, Mode=OneWay}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Duration, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Severity}" Foreground="{Binding SeverityBrush}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                    <CheckBox Margin="0,9,0,0" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Page.Overview">
        <ScrollViewer>
            <StackPanel Margin="0,0,8,28">
                <Border Style="{StaticResource CardBorder}" BorderBrush="#5543E7D2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Success}" Margin="0,3,9,0"/>
                                <TextBlock Text="SETTINGS SYNCHRONIZED" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Brush.Success}"/>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" Text="Your desktop, at a glance." Style="{StaticResource PageTitleText}" FontSize="28"/>
                            <TextBlock Margin="0,7,0,0"
                                       Text="Configured modules use adaptive, non-overlapping polling."
                                       Style="{StaticResource BodyText}"/>
                            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                <Button Content="Edit active widget"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="widgets"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Review providers"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="providers"
                                        Style="{StaticResource StudioButton}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="140"
                                Margin="20,0,0,0"
                                Padding="16"
                                Background="#1443E7D2"
                                BorderBrush="#4443E7D2"
                                BorderThickness="1"
                                CornerRadius="16">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SCENE" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,8,0,0" Text="{Binding ActiveScene, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedLayout}" Foreground="{StaticResource Brush.Accent}" FontSize="13"/>
                                <TextBlock Margin="0,18,0,0" Text="ACTIVE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Margin="0,24,0,10" Text="Resource impact" Style="{StaticResource SectionTitleText}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MiniMetric}">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,6,0,2" Text="{Binding ResourceCpu}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Studio + widget" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MiniMetric}">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,6,0,2" Text="{Binding ResourceMemory}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Working set" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MiniMetric}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SENSOR WAKEUPS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,6,0,2" Text="{Binding ResourceWakeups}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Adaptive rate" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Scenes" Style="{StaticResource SectionTitleText}"/>
                                <Button HorizontalAlignment="Right"
                                        Content="Manage"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="widgets"
                                        Style="{StaticResource StudioButton}"/>
                            </Grid>
                            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Scenes}" ItemTemplate="{StaticResource SceneCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource SectionTitleText}"/>
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="15"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="0,3,0,0" Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Time}" Style="{StaticResource CaptionText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Widgets">
        <ScrollViewer>
            <StackPanel Margin="0,0,8,28">
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Layout editor" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,0" Text="Build once, then reuse the arrangement across scenes." Style="{StaticResource BodyText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="↶" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}" Style="{StaticResource IconButton}" Margin="0,0,6,0"/>
                            <Button Content="↷" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}" Style="{StaticResource IconButton}" Margin="0,0,12,0"/>
                            <Button Content="Equalize" Command="{Binding EqualizeCommand}" Style="{StaticResource StudioButton}" Margin="0,0,6,0"/>
                            <Button Content="Duplicate" Command="{Binding DuplicateModuleCommand}" Style="{StaticResource StudioButton}" Margin="0,0,6,0"/>
                            <Button Content="Delete" Command="{Binding DeleteModuleCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,22,0,10" Text="Form factor" Style="{StaticResource SectionTitleText}"/>
                <ItemsControl ItemsSource="{Binding Layouts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,0"
                                    Command="{Binding DataContext.SelectLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Id}"
                                    Style="{StaticResource StudioButton}">
                                <StackPanel Margin="4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Icon}" FontSize="23" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Description}" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Brush.Accent}">
                    <Run Text="Active: "/>
                    <Run Text="{Binding SelectedLayout, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Module stack" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,4,0,14" Text="Visibility, order, and footprint update the preview instantly." Style="{StaticResource CaptionText}"/>
                            <ListBox ItemsSource="{Binding Modules}"
                                     SelectedItem="{Binding SelectedModule}"
                                     ItemContainerStyle="{StaticResource CompactListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="17" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,2,0,0" Text="{Binding Category}" Style="{StaticResource CaptionText}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2" Margin="6,0" ItemsSource="{Binding DataContext.ModuleSizes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Size}"/>
                                            <Button Grid.Column="3"
                                                    Content="↑"
                                                    ToolTip="Move up"
                                                    Command="{Binding DataContext.MoveModuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"/>
                                            <Button Grid.Column="4"
                                                    Content="↓"
                                                    ToolTip="Move down"
                                                    Command="{Binding DataContext.MoveModuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"/>
                                            <CheckBox Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsVisible}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Placement grid" Style="{StaticResource SectionTitleText}"/>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Snap modules" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,0" Text="Keep cards and gaps precise." Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SnapToGrid}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,14,0,4" Text="Grid size" Style="{StaticResource EyebrowText}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="4" Maximum="20" TickFrequency="2" Value="{Binding GridSize}"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding GridSize, StringFormat={}{0:0}px}" Foreground="{StaticResource Brush.Accent}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Scene behavior" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Margin="0,8,0,4" Text="Auto-switch rule" Style="{StaticResource EyebrowText}"/>
                                <ComboBox SelectedIndex="0"
                                          IsEnabled="False"
                                          ToolTip="Automatic scene switching is not available in v2.0.">
                                    <ComboBoxItem Content="Manual only"/>
                                    <ComboBoxItem Content="When a game opens"/>
                                    <ComboBoxItem Content="When streaming starts"/>
                                    <ComboBoxItem Content="By time of day"/>
                                </ComboBox>
                                <Button Margin="0,12,0,0"
                                        Content="+ New scene"
                                        IsEnabled="False"
                                        ToolTip="Custom scene creation is planned for a later release."
                                        Style="{StaticResource StudioButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,24,0,10" Text="Saved scenes" Style="{StaticResource SectionTitleText}"/>
                <ItemsControl ItemsSource="{Binding Scenes}" ItemTemplate="{StaticResource SceneCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Modules">
        <ScrollViewer>
            <StackPanel Margin="0,0,8,28">
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Metric catalog" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,0" Text="Every signal is modular. Enable only what earns its space." Style="{StaticResource BodyText}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource TagBorder}">
                            <TextBlock Foreground="{StaticResource Brush.Accent}">
                                <Run Text="{Binding VisibleModulesView.Count, Mode=OneWay}"/>
                                <Run Text=" visible"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             Margin="0,0,10,0"
                             ItemsSource="{Binding Modules}"
                             SelectedItem="{Binding SelectedModule}"
                             ItemContainerStyle="{StaticResource CompactListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#142B3444" CornerRadius="9">
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,10,0" Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
                                        <TextBlock Margin="0,7,0,0" Text="{Binding Source}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" MinWidth="90">
                                        <TextBlock Text="{Binding PrimaryValue}" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"/>
                                        <CheckBox Margin="0,12,0,0" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsVisible}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" DataContext="{Binding SelectedModule}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="20" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </StackPanel>
                            <Separator Style="{StaticResource HairlineSeparator}"/>
                            <TextBlock Text="Card size" Style="{StaticResource EyebrowText}"/>
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding DataContext.ModuleSizes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Size}"/>
                            <TextBlock Margin="0,16,0,0" Text="Visualization" Style="{StaticResource EyebrowText}"/>
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding DataContext.Visualizations, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Visualization}"/>
                            <TextBlock Margin="0,16,0,0" Text="Number precision" Style="{StaticResource EyebrowText}"/>
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding DataContext.PrecisionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Precision}"/>

                            <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="Show label" VerticalAlignment="Center"/>
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowLabel}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <TextBlock Text="Show sparkline" VerticalAlignment="Center"/>
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSparkline}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <TextBlock Text="Show temperature" VerticalAlignment="Center"/>
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTemperature}"/>
                                </Grid>
                            </Border>
                            <Button Margin="0,14,0,0"
                                    Content="Add to active widget"
                                    Command="{Binding DataContext.AddModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Appearance">
        <ScrollViewer>
            <StackPanel Margin="0,0,8,28">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Theme gallery" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,5,0,14" Text="Curated foundations keep contrast disciplined while accents stay expressive." Style="{StaticResource BodyText}"/>
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="170"
                                            Margin="0,0,9,9"
                                            Padding="10"
                                            Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource StudioButton}">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Border Height="66" Background="{Binding SurfaceBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="10">
                                                <Grid Margin="10">
                                                    <Border Width="42" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{Binding CardBrush}" CornerRadius="6"/>
                                                    <Ellipse Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{Binding AccentBrush}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Margin="2,9,0,0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Margin="2,3,0,0" Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Glass &amp; surface" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,16,0,4" Text="Background opacity" Style="{StaticResource EyebrowText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <Slider Minimum="0.3" Maximum="1" Value="{Binding BackgroundOpacity}"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"/>
                            </Grid>
                            <TextBlock Margin="0,14,0,4" Text="Blur strength" Style="{StaticResource EyebrowText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="40" Value="{Binding BlurStrength}"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" Text="{Binding BlurStrength, StringFormat={}{0:0}px}"/>
                            </Grid>
                            <TextBlock Margin="0,14,0,4" Text="Content opacity" Style="{StaticResource EyebrowText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
