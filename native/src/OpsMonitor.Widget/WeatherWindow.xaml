<Window x:Class="OpsMonitor.Widget.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpsMonitor.Widget.Controls"
        Title="OPS Weather Station"
        Width="1240"
        Height="820"
        MinWidth="860"
        MinHeight="620"
        Background="#080D13"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed">
    <Window.Resources>
        <SolidColorBrush x:Key="StationBackground" Color="#080D13" />
        <SolidColorBrush x:Key="RailBackground" Color="#0C141E" />
        <SolidColorBrush x:Key="PanelBackground" Color="#101B28" />
        <SolidColorBrush x:Key="PanelRaised" Color="#142232" />
        <SolidColorBrush x:Key="PanelInset" Color="#0D1722" />
        <SolidColorBrush x:Key="Line" Color="#26394C" />
        <SolidColorBrush x:Key="LineStrong" Color="#38536C" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F7FC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A5B7CB" />
        <SolidColorBrush x:Key="TextDim" Color="#6F849A" />
        <SolidColorBrush x:Key="Cyan" Color="#5BE1FF" />
        <SolidColorBrush x:Key="Blue" Color="#759BFF" />
        <SolidColorBrush x:Key="Mint" Color="#6DE6BC" />
        <SolidColorBrush x:Key="Amber" Color="#FFD06A" />
        <SolidColorBrush x:Key="Violet" Color="#B9A7FF" />
        <SolidColorBrush x:Key="Danger" Color="#FF8791" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="RaisedPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        </Style>
        <Style x:Key="StationButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#192638" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#28405A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cyan}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource StationButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="13,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#25415C" />
                                <Setter Property="Foreground" Value="{StaticResource Cyan}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#192C40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StationTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="14,18" Background="{StaticResource RailBackground}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="WEATHER STATION" />
                                    <TextBlock Margin="0,4,0,18" FontSize="12" Foreground="{StaticResource TextDim}" Text="OPS / LOCAL SIGNAL" />
                                    <StackPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                    <Border Margin="0,22,0,0" Padding="11" Background="{StaticResource PanelInset}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Eyebrow}" Text="DATA STACK" />
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource Secondary}" Text="ARSO · OPEN-METEO" />
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="CAMS · RADAR" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource StationBackground}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="22,18,22,0"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource StationBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,13,0">
                <Ellipse Fill="#2449DFFF" />
                <controls:WeatherIcon Width="40" Height="40" WeatherCode="{Binding Current.WeatherCode}" IsDay="{Binding Current.IsDayValue}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="OPS WEATHER" />
                    <Border Margin="10,0,0,0" Padding="7,3" Background="#223D6378" CornerRadius="6"><TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource Cyan}" Text="LIVE" /></Border>
                </StackPanel>
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Secondary}" Text="A calm station for local conditions" />
            </StackPanel>

            <Grid x:Name="LocationSearchHost" Grid.Column="2" Margin="12,0">
                <Border Background="{StaticResource PanelInset}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="11" />
                <Grid Margin="12,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold" Text="PLACE" />
                    <TextBox x:Name="LocationSearchBox" Grid.Column="1" Margin="10,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Cyan}" FontSize="13" Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="LocationSearchBox_OnKeyDown" />
                    <Button Grid.Column="2" Width="44" Height="30" Padding="0" Click="SearchButton_OnClick" Style="{StaticResource StationButton}" Content="FIND" FontSize="9" />
                </Grid>
                <Popup Width="370" AllowsTransparency="True" IsOpen="{Binding IsSearchOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=LocationSearchHost}" StaysOpen="False" VerticalOffset="8">
                    <Border Padding="8" Background="#FF101A25" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="12">
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,1" Padding="10,8" HorizontalContentAlignment="Left" Click="LocationResult_OnClick" Style="{StaticResource StationButton}">
                                            <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="{Binding DisplayName}" /></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <Button Grid.Column="3" Margin="0,0,8,0" Click="RefreshButton_OnClick" Style="{StaticResource IconButton}" Content="REFRESH" ToolTip="Refresh weather" />
            <Button Grid.Column="4" Click="CloseButton_OnClick" Style="{StaticResource IconButton}" Content="CLOSE" ToolTip="Close weather station" />
        </Grid>

        <TabControl Grid.Row="1" x:Name="WeatherTabs" Style="{StaticResource StationTabs}" ItemContainerStyle="{StaticResource NavTab}" SelectionChanged="WeatherTabs_OnSelectionChanged">
            <TabItem x:Name="NowTab">
                <TabItem.Header><StackPanel><TextBlock FontSize="10" FontWeight="Bold" Text="01" /><TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="NOW" /></StackPanel></TabItem.Header>
                <ScrollViewer x:Name="OverviewScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,22">
                        <Border Margin="0,0,0,14" Padding="13" Background="#2A402732" BorderBrush="#5570B99A" BorderThickness="1" CornerRadius="12" Visibility="{Binding AlertVisibility}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource Danger}" FontSize="10" FontWeight="Bold" Text="ALERT" /><StackPanel Grid.Column="1" Margin="13,0"><TextBlock FontWeight="SemiBold" Text="{Binding Current.Alert.Headline}" /><TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="Official regional warning" /></StackPanel><TextBlock Grid.Column="2" Foreground="{StaticResource Danger}" FontSize="10" FontWeight="Bold" Text="{Binding Current.Alert.LevelLabel}" /></Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                            <Border Margin="0,0,8,0" Padding="24" Style="{StaticResource RaisedPanel}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="185" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Width="170" Height="170" HorizontalAlignment="Center"><Ellipse x:Name="HeroGlow" Fill="#1B5BE1FF"><Ellipse.Effect><BlurEffect Radius="24" /></Ellipse.Effect></Ellipse><Ellipse x:Name="HeroGlowCore" Fill="#253C92FF"><Ellipse.Effect><BlurEffect Radius="34" /></Ellipse.Effect></Ellipse><controls:WeatherIcon Width="158" Height="158" WeatherCode="{Binding Current.WeatherCode}" IsDay="{Binding Current.IsDayValue}" /></Grid>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource Cyan}" Text="{Binding Current.Location.DisplayName}" /><TextBlock Margin="0,2,0,-3" FontSize="76" FontWeight="Light" Text="{Binding Current.TemperatureLabel}" /><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Current.Condition}" /><TextBlock Margin="0,7,0,0" Style="{StaticResource Secondary}" Text="{Binding Current.FeelsLikeLabel}" /><Border Margin="0,14,0,0" Padding="9,5" HorizontalAlignment="Left" Background="#254A6A59" CornerRadius="7"><TextBlock Foreground="{StaticResource Mint}" FontSize="10" FontWeight="Bold" Text="{Binding Current.Confidence.Label}" /></Border><TextBlock Margin="0,12,0,0" Style="{StaticResource Secondary}" Text="{Binding Current.FreshnessLabel}" TextWrapping="Wrap" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="20" Style="{StaticResource Panel}">
                                <StackPanel><Grid><TextBlock Style="{StaticResource Eyebrow}" Text="LIVE READINGS" /><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Right" Style="{StaticResource Secondary}" Text="{Binding Current.StationName}" /><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Cyan}" FontSize="10" Text="{Binding Current.CoordinateLabel}" /></StackPanel></Grid><UniformGrid Margin="0,18,0,0" Columns="2" Rows="6"><StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource Eyebrow}" Text="HUMIDITY" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding Current.HumidityLabel}" /></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Style="{StaticResource Eyebrow}" Text="WIND" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.WindLabel}" /></StackPanel><StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource Eyebrow}" Text="RAIN NEXT HOUR" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Cyan}" FontSize="22" FontWeight="SemiBold" Text="{Binding Current.RainLabel}" /></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Style="{StaticResource Eyebrow}" Text="PRESSURE" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.PressureLabel}" /></StackPanel><StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource Eyebrow}" Text="UV INDEX" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Amber}" FontSize="22" FontWeight="SemiBold" Text="{Binding Current.UvIndexLabel}" /></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Style="{StaticResource Eyebrow}" Text="VISIBILITY" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.VisibilityLabel}" /></StackPanel><StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource Eyebrow}" Text="DEW POINT" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.DewPointLabel}" /></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Style="{StaticResource Eyebrow}" Text="CLOUD COVER" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.CloudLabel}" /></StackPanel><StackPanel Margin="0,0,10,12"><TextBlock Style="{StaticResource Eyebrow}" Text="SNOW DEPTH" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Blue}" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.SnowDepthLabel}" /></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Style="{StaticResource Eyebrow}" Text="FREEZING LEVEL" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.FreezingLevelLabel}" /></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Eyebrow}" Text="WIND GUST" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.GustLabel}" /></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Eyebrow}" Text="SOIL TEMP" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Current.SoilTemperatureLabel}" /></StackPanel></UniformGrid></StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,22,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="RAIN TRACK" /><TextBlock Margin="0,2,0,0" Style="{StaticResource Eyebrow}" Text="NEXT 4 HOURS · 15-MINUTE GUIDANCE" /></StackPanel><TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Eyebrow}" Text="MODEL BLEND" /><Button x:Name="NowcastScrollLeft" Grid.Column="2" Click="NowcastScrollLeft_OnClick" Style="{StaticResource IconButton}" Content="‹" ToolTip="Scroll rain track left" /><Button x:Name="NowcastScrollRight" Grid.Column="3" Click="NowcastScrollRight_OnClick" Style="{StaticResource IconButton}" Content="›" ToolTip="Scroll rain track right" /></Grid>
                        <ScrollViewer x:Name="NowcastScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" ScrollChanged="HorizontalStrip_OnScrollChanged" PreviewMouseWheel="HorizontalStrip_OnPreviewMouseWheel"><ItemsControl ItemsSource="{Binding Nowcast}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="108" Margin="0,0,8,0" Padding="12" Style="{StaticResource Panel}"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" Style="{StaticResource Eyebrow}" Text="{Binding TimeLabel}" /><controls:WeatherIcon Width="48" Height="48" Margin="0,5,0,2" WeatherCode="{Binding WeatherCode}" IsDay="{Binding IsDayValue}" Subtle="True" /><TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Cyan}" FontSize="13" FontWeight="SemiBold" Text="{Binding RainLabel}" /><TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Style="{StaticResource Eyebrow}" Text="{Binding ConfidenceScore, StringFormat={}{0}% AGREE}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <Border Margin="0,18,0,0" Padding="16" Style="{StaticResource Panel}" Visibility="{Binding OfficialOutlookVisibility}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource Cyan}" Text="OFFICIAL OUTLOOK" /><TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Current.OfficialOutlook.Summary}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding Current.OfficialOutlook.SourceLabel}" /></StackPanel><Border Grid.Column="1" Padding="10,6" Background="#243D5A69" CornerRadius="7"><TextBlock Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold" Text="ARSO" /></Border></Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel><TextBlock FontSize="10" FontWeight="Bold" Text="02" /><TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="FORECAST" /></StackPanel></TabItem.Header>
                <ScrollViewer x:Name="ForecastScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,22"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="HOURLY WINDOW" /><TextBlock Margin="0,2,0,0" Style="{StaticResource Eyebrow}" Text="NEXT 24 HOURS · TEMPERATURE · RAIN · WIND" /></StackPanel><Border Grid.Column="1" Margin="0,0,10,0" Padding="8,5" Background="#24415C4D" CornerRadius="7"><TextBlock Foreground="{StaticResource Mint}" FontSize="10" FontWeight="Bold" Text="{Binding Current.Confidence.Label}" /></Border><Button x:Name="HourlyScrollLeft" Grid.Column="2" Click="HourlyScrollLeft_OnClick" Style="{StaticResource IconButton}" Content="‹" ToolTip="Scroll hourly forecast left" /><Button x:Name="HourlyScrollRight" Grid.Column="3" Click="HourlyScrollRight_OnClick" Style="{StaticResource IconButton}" Content="›" ToolTip="Scroll hourly forecast right" /></Grid><ScrollViewer x:Name="HourlyScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" ScrollChanged="HorizontalStrip_OnScrollChanged" PreviewMouseWheel="HorizontalStrip_OnPreviewMouseWheel"><ItemsControl ItemsSource="{Binding Hourly}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="142" Margin="0,0,9,0" Padding="14" Style="{StaticResource Panel}"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" Style="{StaticResource Eyebrow}" Text="{Binding TimeLabel}" /><controls:WeatherIcon Width="64" Height="64" Margin="0,7,0,2" WeatherCode="{Binding WeatherCode}" IsDay="{Binding IsDayValue}" Subtle="True" /><TextBlock HorizontalAlignment="Center" FontSize="23" FontWeight="SemiBold" Text="{Binding TemperatureLabel}" /><TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Cyan}" FontSize="11" Text="{Binding RainLabel}" /><TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" Style="{StaticResource Eyebrow}" Text="{Binding DetailLabel}" /><TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Style="{StaticResource Eyebrow}" Text="{Binding PressureLabel}" /><TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Amber}" FontSize="10" Text="{Binding UvLabel}" /><TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Mint}" FontSize="10" Text="{Binding ConfidenceLabel, StringFormat={}AGREE {0}}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Grid Margin="0,25,0,10"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="EIGHT-DAY OUTLOOK" /><TextBlock Margin="0,2,0,0" Style="{StaticResource Eyebrow}" Text="DAILY RANGE · PRECIPITATION · WIND · CONFIDENCE" /></StackPanel></Grid><ItemsControl ItemsSource="{Binding Daily}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="15,12" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /><ColumnDefinition Width="175" /><ColumnDefinition Width="190" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding DayLabel}" /><TextBlock Margin="0,3,0,0" Style="{StaticResource Eyebrow}" Text="{Binding DaylightLabel}" /></StackPanel><controls:WeatherIcon Grid.Column="1" Width="48" Height="48" VerticalAlignment="Center" WeatherCode="{Binding WeatherCode}" IsDay="True" Subtle="True" /><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding RangeLabel}" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Blue}" FontSize="10" Text="{Binding SnowLabel}" /></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Style="{StaticResource Eyebrow}" Text="PRECIPITATION" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Cyan}" FontSize="13" Text="{Binding RainLabel}" /></StackPanel><StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Style="{StaticResource Eyebrow}" Text="WIND" /><TextBlock Margin="0,3,0,0" Style="{StaticResource Secondary}" Text="{Binding WindLabel}" /></StackPanel><TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Mint}" FontSize="10" Text="{Binding ConfidenceLabel}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
            </TabItem>

            <TabItem x:Name="RadarTab">
                <TabItem.Header><StackPanel><TextBlock FontSize="10" FontWeight="Bold" Text="03" /><TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="RADAR" /></StackPanel></TabItem.Header>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Padding="16,13" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="ARSO PRECIPITATION RADAR" /><TextBlock Margin="0,3,0,0" Style="{StaticResource Eyebrow}" Text="SLOVENIA COMPOSITE · 5-MINUTE SOURCE CADENCE" /></StackPanel><TextBlock Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Eyebrow}" Text="ZOOM" /><Slider Grid.Column="2" Width="130" Minimum="0.6" Maximum="2.2" Value="{Binding RadarZoom, Mode=TwoWay}" /></Grid></Border><Border Grid.Row="1" Margin="0,12" Background="#05080D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" ClipToBounds="True"><Grid><ScrollViewer HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"><Image x:Name="RadarImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding RadarZoom}" ScaleY="{Binding RadarZoom}" /></Image.LayoutTransform></Image></ScrollViewer><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="14" Text="{Binding RadarStatus}" Visibility="{Binding RadarStatusVisibility}" /></Grid></Border><Border Grid.Row="2" Padding="13,10" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><Button x:Name="RadarPlayButton" Width="92" Click="RadarPlayButton_OnClick" Style="{StaticResource StationButton}" Content="{Binding RadarPlayLabel}" /><Slider x:Name="RadarTimeline" Grid.Column="1" Margin="16,0" Minimum="0" Maximum="1" IsSnapToTickEnabled="True" ValueChanged="RadarTimeline_OnValueChanged" /><TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding RadarFrameLabel}" /></Grid></Border></Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel><TextBlock FontSize="10" FontWeight="Bold" Text="04" /><TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="ENVIRONMENT" /></StackPanel></TabItem.Header>
                <ScrollViewer x:Name="EnvironmentScroller" VerticalScrollBarVisibility="Hidden"><StackPanel Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions><Border Margin="0,0,8,0" Padding="22" Style="{StaticResource RaisedPanel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="AIR QUALITY" /><StackPanel Margin="0,16,0,0" Orientation="Horizontal"><TextBlock FontSize="68" FontWeight="Light" Foreground="{StaticResource Mint}" Text="{Binding Current.AirQuality.EuropeanAqi, TargetNullValue=N/A}" /><StackPanel Margin="18,9,0,0"><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Current.AirQuality.AqiLabel}" /><TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="CAMS EUROPEAN MODEL" /></StackPanel></StackPanel><UniformGrid Margin="0,22,0,0" Columns="2" Rows="2"><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="PM2.5" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.Pm25, StringFormat={}{0:0.0} ug/m3, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="PM10" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.Pm10, StringFormat={}{0:0.0} ug/m3, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="NO2" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.NitrogenDioxide, StringFormat={}{0:0.0} ug/m3, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="O3" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.Ozone, StringFormat={}{0:0.0} ug/m3, TargetNullValue=N/A}" /></StackPanel></UniformGrid></StackPanel></Border><Border Grid.Column="1" Margin="8,0,0,0" Padding="22" Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="UV AND POLLEN" /><UniformGrid Margin="0,18,0,0" Columns="2" Rows="3"><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="UV INDEX" /><TextBlock Margin="0,3,0,0" Foreground="{StaticResource Amber}" FontSize="28" Text="{Binding Current.AirQuality.UvIndex, StringFormat={}{0:0.0}, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="TODAY MAX UV" /><TextBlock Margin="0,3,0,0" FontSize="28" Text="{Binding Daily[0].UvIndex, StringFormat={}{0:0.0}, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="GRASS" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.GrassPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="BIRCH" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.BirchPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="ALDER" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.AlderPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" /></StackPanel><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="RAGWEED" /><TextBlock Margin="0,3,0,0" FontSize="20" Text="{Binding Current.AirQuality.RagweedPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" /></StackPanel></UniformGrid></StackPanel></Border></Grid><Border Margin="0,14,0,0" Padding="22" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="SUNRISE" /><TextBlock Margin="0,7,0,0" FontSize="32" FontWeight="Light" Text="{Binding Daily[0].Sunrise, StringFormat={}{0:HH:mm}, TargetNullValue=N/A}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Eyebrow}" Text="SUNSET" /><TextBlock Margin="0,7,0,0" FontSize="32" FontWeight="Light" Text="{Binding Daily[0].Sunset, StringFormat={}{0:HH:mm}, TargetNullValue=N/A}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Eyebrow}" Text="DAYLIGHT" /><TextBlock Margin="0,7,0,0" FontSize="32" FontWeight="Light" Text="{Binding DaylightLabel}" /></StackPanel></Grid></Border><Border Margin="0,14,0,0" Padding="18" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="SO2" /><TextBlock Margin="0,4,0,0" FontSize="18" Text="{Binding Current.AirQuality.SulphurDioxide, StringFormat={}{0:0.0} ug/m3, TargetNullValue=N/A}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Eyebrow}" Text="CO" /><TextBlock Margin="0,4,0,0" FontSize="18" Text="{Binding Current.AirQuality.CarbonMonoxide, StringFormat={}{0:0.0} ug/m3, TargetNullValue=N/A}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Eyebrow}" Text="SOIL" /><TextBlock Margin="0,4,0,0" FontSize="18" Text="{Binding Current.SoilTemperatureLabel}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Eyebrow}" Text="FREEZING LEVEL" /><TextBlock Margin="0,4,0,0" FontSize="18" Text="{Binding Current.FreezingLevelLabel}" /></StackPanel></Grid></Border></StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="24,0,24,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Eyebrow}" Text="ARSO · OPEN-METEO · CAMS" />
        </Grid>
    </Grid>
</Window>
