<Window x:Class="OpsMonitor.Widget.MainWindow"
        x:Name="WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpsMonitor.Widget.Controls"
        xmlns:models="clr-namespace:OpsMonitor.Widget.Models"
        Title="OPS Monitor"
        Width="196"
        Height="326"
        MinWidth="176"
        MinHeight="150"
        MaxWidth="1600"
        MaxHeight="1000"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{Binding WidgetFontFamily}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding Topmost}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VerticalMetricPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="DockMetricPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource WidgetReadableText}" />

        <Style x:Key="WidgetHeaderTitleTextStyle"
               BasedOn="{StaticResource WidgetReadableText}"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{Binding WidgetFontFamily}" />
            <Setter Property="FontSize" Value="{Binding HeaderFontSize}" />
            <Setter Property="FontWeight" Value="{Binding HeaderFontWeight}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density}" Value="{x:Static models:WidgetDensity.Compact}">
                    <Setter Property="FontSize" Value="11" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetHeaderMetaTextStyle"
               BasedOn="{StaticResource WidgetReadableText}"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{Binding WidgetFontFamily}" />
            <Setter Property="FontSize" Value="{Binding SecondaryFontSize}" />
            <Setter Property="FontWeight" Value="{Binding SecondaryFontWeight}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density}" Value="{x:Static models:WidgetDensity.Compact}">
                    <Setter Property="FontSize" Value="10.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              Effect="{StaticResource WidgetTextHalo}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3348DCF9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3048DCF9" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6648DCF9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9958E6B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{Binding TrackBrush}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{Binding WidgetFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              Effect="{StaticResource WidgetTextHalo}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Background" Value="{Binding TrackBrush}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{Binding WidgetFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              Effect="{StaticResource WidgetTextHalo}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#7848DCF9" />
                                <Setter TargetName="Chrome" Property="Background" Value="#2E48DCF9" />
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabelStyle"
               BasedOn="{StaticResource WidgetReadableText}"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{Binding WidgetFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FF171C27" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{Binding WidgetFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource SettingComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ComboChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="10,0,2,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  Effect="{StaticResource WidgetTextHalo}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M1,1 L4,4 L7,1"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeThickness="1.4" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#8248DCF9" />
                                                <Setter TargetName="ComboChrome" Property="Background" Value="#FF1C2532" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="#FF141A24"
                                        BorderBrush="#FF344052"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          Direction="270"
                                                          Opacity="0.44"
                                                          ShadowDepth="4"
                                                          Color="#FF000000" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingComboItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Foreground"
                    Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="7">
                            <ContentPresenter Effect="{StaticResource WidgetTextHalo}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#2E48DCF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#3A58E6B2" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Margin="1,0">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="#FF48DCF9"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding DataContext.TrackBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="14"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbChrome"
                                                        Background="#FFF4FAFF"
                                                        BorderBrush="#FF48DCF9"
                                                        BorderThickness="2"
                                                        CornerRadius="7" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#FFFFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:WidgetLayout.Dock}">
                        <Setter Property="Margin" Value="6" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:WidgetLayout.Mini}">
                        <Setter Property="Margin" Value="6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border x:Name="RootSurface"
                Background="{Binding SurfaceBrush}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="{Binding ShellBorderThickness}"
                CornerRadius="{Binding ShellCornerRadius}"
                MouseLeftButtonDown="DragHeader_OnMouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Padding" Value="{Binding ShellContentPadding}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:WidgetLayout.Pill}">
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:WidgetLayout.Dock}">
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:WidgetLayout.Mini}">
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Density}" Value="{x:Static models:WidgetDensity.Compact}">
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  Opacity="{Binding ShellShadowOpacity}"
                                  ShadowDepth="5"
                                  Color="#FF000000" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Border Height="72"
                        VerticalAlignment="Top"
                        Background="{Binding ShellGlowBrush}"
                        CornerRadius="25,25,0,0"
                        Opacity="{Binding ShellGlowOpacity}">
                </Border>

                <Grid x:Name="StandardLayout">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ContentScaleFactor}"
                                        ScaleY="{Binding ContentScaleFactor}" />
                    </Grid.LayoutTransform>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Layout}"
                                             Value="{x:Static models:WidgetLayout.Dock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DragHeader"
                          Grid.Row="0"
                          Background="Transparent"
                          Opacity="{Binding ContentOpacity}"
                          MouseLeftButtonDown="DragHeader_OnMouseLeftButtonDown"
                          Visibility="{Binding HeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Height" Value="{Binding HeaderHeight}" />
                                <Setter Property="Margin" Value="12,5,10,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout}"
                                                 Value="{x:Static models:WidgetLayout.Mini}">
                                        <Setter Property="Height" Value="22" />
                                        <Setter Property="Margin" Value="8,1,7,0" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Layout}"
                                                       Value="{x:Static models:WidgetLayout.Mini}" />
                                            <Condition Binding="{Binding Density}"
                                                       Value="{x:Static models:WidgetDensity.Compact}" />
                                            <Condition Binding="{Binding IsReducedScale}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Height" Value="19" />
                                        <Setter Property="Margin" Value="6,0,5,0" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Layout}"
                                                       Value="{x:Static models:WidgetLayout.Pill}" />
                                            <Condition Binding="{Binding Density}"
                                                       Value="{x:Static models:WidgetDensity.Compact}" />
                                            <Condition Binding="{Binding IsReducedScale}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Height" Value="34" />
                                        <Setter Property="Margin" Value="10,3,8,1" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="4"
                                Background="{Binding ReadabilityPlateBrush}"
                                CornerRadius="10" />

                        <Border Width="26"
                                Height="26"
                                Margin="0,0,8,0"
                                Background="{Binding TrackBrush}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="{Binding StatusIndicatorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout}"
                                                     Value="{x:Static models:WidgetLayout.Mini}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Ellipse x:Name="StandardUpdatePulseDot"
                                         Width="7"
                                         Height="7"
                                         Fill="{Binding SuccessBrush}" />
                                <Ellipse Width="16"
                                         Height="16"
                                         x:Name="StandardUpdatePulseRing"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5"
                                         Stroke="{Binding SuccessBrush}"
                                         StrokeThickness="1">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="StandardUpdatePulseScale"
                                                        ScaleX="0.6"
                                                        ScaleY="0.6" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>

                        <Grid x:Name="MiniUpdatePulse"
                              Grid.Column="0"
                              Width="11"
                              Height="11"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout}"
                                                     Value="{x:Static models:WidgetLayout.Mini}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse x:Name="MiniUpdatePulseRing"
                                     Width="10"
                                     Height="10"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5"
                                     Stroke="{Binding SuccessBrush}"
                                     StrokeThickness="1">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MiniUpdatePulseScale"
                                                    ScaleX="0.6"
                                                    ScaleY="0.6" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="MiniUpdatePulseDot"
                                     Width="5"
                                     Height="5"
                                     Fill="{Binding SuccessBrush}" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{Binding TextPrimaryBrush}"
                                       Style="{StaticResource WidgetHeaderTitleTextStyle}"
                                       Text="{Binding BrandLabel}" />
                            <TextBlock Margin="0,1,0,0"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       Text="{Binding LastUpdatedText}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource WidgetHeaderMetaTextStyle}"
                                           TargetType="{x:Type TextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Layout}"
                                                         Value="{x:Static models:WidgetLayout.Mini}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Margin="8,0,8,0"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Background="#2148DCF9"
                                BorderBrush="#5948DCF9"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center"
                                         Fill="#FF48DCF9" />
                                <TextBlock Foreground="{Binding TextPrimaryBrush}"
                                           Style="{StaticResource WidgetHeaderTitleTextStyle}"
                                           Text="{Binding ModeLabel}" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="SettingsButton"
                                Grid.Column="3"
                                AutomationProperties.Name="Quick settings"
                                Click="SettingsButton_OnClick"
                                Visibility="{Binding SettingsButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource IconButtonStyle}"
                                       TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout}"
                                                     Value="{x:Static models:WidgetLayout.Mini}">
                                            <Setter Property="Width" Value="20" />
                                            <Setter Property="Height" Value="20" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Layout}"
                                                           Value="{x:Static models:WidgetLayout.Mini}" />
                                                <Condition Binding="{Binding Density}"
                                                           Value="{x:Static models:WidgetDensity.Compact}" />
                                                <Condition Binding="{Binding IsReducedScale}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="18" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Segoe UI Symbol"
                                       Text="⚙">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="18" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Layout}"
                                                         Value="{x:Static models:WidgetLayout.Mini}">
                                                <Setter Property="FontSize" Value="13" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Layout}"
                                                               Value="{x:Static models:WidgetLayout.Mini}" />
                                                    <Condition Binding="{Binding Density}"
                                                               Value="{x:Static models:WidgetDensity.Compact}" />
                                                    <Condition Binding="{Binding IsReducedScale}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="FontSize" Value="12" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Hidden">
                        <ScrollViewer.Style>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Margin" Value="10,0,10,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout}"
                                                 Value="{x:Static models:WidgetLayout.Mini}">
                                        <Setter Property="Margin" Value="7,0,7,0" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Layout}"
                                                       Value="{x:Static models:WidgetLayout.Pill}" />
                                            <Condition Binding="{Binding Density}"
                                                       Value="{x:Static models:WidgetDensity.Compact}" />
                                            <Condition Binding="{Binding IsReducedScale}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Margin" Value="6,0,6,0" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Metrics}">
                            <ItemsControl.Style>
                                <Style TargetType="{x:Type ItemsControl}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource VerticalMetricPanel}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout}" Value="{x:Static models:WidgetLayout.Dock}">
                                            <Setter Property="ItemsPanel" Value="{StaticResource DockMetricPanel}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MetricCard Layout="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Density="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         ContentOpacity="{Binding DataContext.ContentOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         PreviewMouseLeftButtonDown="MetricCard_OnPreviewMouseLeftButtonDown"
                                                         PreviewMouseLeftButtonUp="MetricCard_OnPreviewMouseLeftButtonUp" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>

                <Grid x:Name="CompactDockLayout"
                      Margin="9,6,8,6"
                      Background="Transparent"
                      MouseLeftButtonDown="DragHeader_OnMouseLeftButtonDown">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ContentScaleFactor}"
                                        ScaleY="{Binding ContentScaleFactor}" />
                    </Grid.LayoutTransform>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Layout}"
                                             Value="{x:Static models:WidgetLayout.Dock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="1,0,8,0"
                          Opacity="{Binding ContentOpacity}"
                          Visibility="{Binding HeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2"
                                Background="{Binding ReadabilityPlateBrush}"
                                CornerRadius="9" />
                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Grid Width="12"
                                  Height="12"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding StatusIndicatorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse x:Name="DockUpdatePulseRing"
                                         Width="11"
                                         Height="11"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5"
                                         Stroke="{Binding SuccessBrush}"
                                         StrokeThickness="1">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="DockUpdatePulseScale"
                                                        ScaleX="0.6"
                                                        ScaleY="0.6" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="DockUpdatePulseDot"
                                         Width="6"
                                         Height="6"
                                         Fill="{Binding SuccessBrush}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{Binding TextPrimaryBrush}"
                                       Style="{StaticResource WidgetHeaderTitleTextStyle}"
                                       Text="OPS DOCK" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="17,2,0,0"
                                   VerticalAlignment="Top"
                                   Foreground="{Binding TextSecondaryBrush}"
                                   Style="{StaticResource WidgetHeaderMetaTextStyle}"
                                   Text="{Binding LastUpdatedText}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Border Grid.Column="1"
                            Margin="0,4"
                            Background="{Binding BorderBrush}" />

                    <Viewbox Grid.Column="2"
                             Margin="8,0,0,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <ItemsControl HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ItemsPanel="{StaticResource DockMetricPanel}"
                                      ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MetricCard Layout="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Density="{x:Static models:WidgetDensity.Compact}"
                                                         ContentOpacity="{Binding DataContext.ContentOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         PreviewMouseLeftButtonDown="MetricCard_OnPreviewMouseLeftButtonDown"
                                                         PreviewMouseLeftButtonUp="MetricCard_OnPreviewMouseLeftButtonUp" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>

                    <Button x:Name="DockSettingsButton"
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Quick settings"
                            Click="SettingsButton_OnClick"
                            Style="{StaticResource IconButtonStyle}"
                            Visibility="{Binding SettingsButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontFamily="Segoe UI Symbol"
                                   FontSize="16"
                                   Text="⚙" />
                    </Button>
                </Grid>

                <!-- Deliberately invisible: resizing stays discoverable through the
                     SizeNWSE cursor without adding permanent corner decoration. -->
                <Border x:Name="ResizeGrip"
                        Width="18"
                        Height="18"
                        Margin="0,0,2,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="20"
                        AutomationProperties.Name="Resize widget"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        MouseLeftButtonDown="ResizeGrip_OnMouseLeftButtonDown"
                        Visibility="{Binding CanResize, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Popup x:Name="QuickSettingsPopup"
               Width="346"
               AllowsTransparency="True"
               HorizontalOffset="-314"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               StaysOpen="False"
               VerticalOffset="8">
            <Border Padding="16"
                    Background="{Binding FlyoutBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.52"
                                      ShadowDepth="5"
                                      Color="#FF000000" />
                </Border.Effect>
                <ScrollViewer MaxHeight="780"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="0,0,4,0">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontFamily="{Binding WidgetFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TextPrimaryBrush}"
                                       Text="Quick settings" />
                            <TextBlock Margin="0,3,0,0"
                                       FontFamily="{Binding WidgetFontFamily}"
                                       FontSize="12"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       Text="Layout, density and interaction" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                AutomationProperties.Name="Close quick settings"
                                Click="CloseSettings_OnClick"
                                Style="{StaticResource IconButtonStyle}">
                            <TextBlock FontFamily="Segoe UI Symbol"
                                       FontSize="15"
                                       Text="✕" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Layout" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="Layout"
                                  ItemsSource="{Binding LayoutOptions}"
                                  SelectedItem="{Binding Layout, Mode=TwoWay}"
                                  Style="{StaticResource SettingComboStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Information density" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="Information density"
                                  IsEnabled="{Binding CanChangeDensity}"
                                  ItemsSource="{Binding DensityOptions}"
                                  SelectedItem="{Binding Density, Mode=TwoWay}"
                                  Style="{StaticResource SettingComboStyle}"
                                  ToolTip="Dock is intentionally fixed to Compact so it stays a slim one-row strip." />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Theme" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="Theme"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding ThemeName, Mode=TwoWay}"
                                  Style="{StaticResource SettingComboStyle}" />
                    </Grid>

                    <Grid Margin="0,2,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Widget scale" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="{Binding WidgetFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   Text="{Binding ScalePercent, StringFormat={}{0}%}" />
                        <Slider Grid.Row="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.Name="Widget scale"
                                Margin="0,7,0,0"
                                Minimum="80"
                                Maximum="160"
                                IsSnapToTickEnabled="True"
                                SmallChange="5"
                                LargeChange="20"
                                TickFrequency="5"
                                Style="{StaticResource SettingSliderStyle}"
                                Value="{Binding ScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Margin="1,2,1,0">
                            <TextBlock HorizontalAlignment="Left"
                                       FontSize="10"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       Text="80" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       Text="100" />
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       Text="160" />
                        </Grid>
                    </Grid>

                    <Grid Margin="0,2,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Shell opacity" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="{Binding WidgetFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   Text="{Binding SurfaceOpacity, StringFormat={}{0:P0}}" />
                        <Slider Grid.Row="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.Name="Shell opacity"
                                Margin="0,7,0,0"
                                Minimum="0.08"
                                Maximum="1"
                                SmallChange="0.02"
                                LargeChange="0.1"
                                TickFrequency="0.05"
                                Style="{StaticResource SettingSliderStyle}"
                                Value="{Binding SurfaceOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Content opacity" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="{Binding WidgetFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   Text="{Binding ContentOpacity, StringFormat={}{0:P0}}" />
                        <Slider Grid.Row="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.Name="Content opacity"
                                Margin="0,7,0,0"
                                Minimum="0.82"
                                Maximum="1"
                                SmallChange="0.02"
                                LargeChange="0.1"
                                TickFrequency="0.05"
                                Style="{StaticResource SettingSliderStyle}"
                                Value="{Binding ContentOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingLabelStyle}" Text="Update frequency" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="{Binding WidgetFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   Text="{Binding UpdateCadenceSeconds, StringFormat={}{0:0.0} s}" />
                        <Slider Grid.Row="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.Name="Update frequency"
                                Margin="0,7,0,0"
                                Minimum="0.5"
                                Maximum="10"
                                SmallChange="0.5"
                                LargeChange="1"
                                TickFrequency="0.5"
                                IsSnapToTickEnabled="True"
                                Style="{StaticResource SettingSliderStyle}"
                                Value="{Binding UpdateCadenceSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Margin="0,0,0,7"
                               Style="{StaticResource SettingLabelStyle}"
                               Text="Window behavior" />
                    <UniformGrid Margin="0,0,0,8" Columns="2">
                        <ToggleButton Margin="0,0,5,0"
                                       Content="Always on top"
                                       IsChecked="{Binding Topmost, Mode=TwoWay}"
                                       Style="{StaticResource SettingToggleStyle}" />
                        <ToggleButton Margin="5,0,0,0"
                                      Content="Start with Windows"
                                      IsChecked="{Binding StartAtSignIn, Mode=TwoWay}"
                                      Style="{StaticResource SettingToggleStyle}" />
                    </UniformGrid>
                    <UniformGrid Margin="0,0,0,8" Columns="2">
                        <ToggleButton Margin="0,0,5,0"
                                      Content="Draggable"
                                      IsChecked="{Binding Draggable, Mode=TwoWay}"
                                      Style="{StaticResource SettingToggleStyle}" />
                        <ToggleButton Margin="5,0,0,0"
                                      Content="Resizable"
                                      IsChecked="{Binding Resizable, Mode=TwoWay}"
                                      Style="{StaticResource SettingToggleStyle}" />
                    </UniformGrid>
                    <ToggleButton Margin="0,0,0,14"
                                  Content="Show battery module"
                                  IsChecked="{Binding ShowBattery, Mode=TwoWay}"
                                  Style="{StaticResource SettingToggleStyle}" />

                    <UniformGrid Margin="0,0,0,14" Columns="2">
                        <ToggleButton Margin="0,0,5,0"
                                      Content="Show weather"
                                      IsChecked="{Binding ShowWeather, Mode=TwoWay}"
                                      Style="{StaticResource SettingToggleStyle}" />
                        <Button Margin="5,0,0,0"
                                Click="OpenWeatherButton_OnClick"
                                Content="Forecast &amp; radar"
                                Style="{StaticResource ActionButtonStyle}" />
                    </UniformGrid>

                    <TextBlock Margin="0,0,0,7"
                               Style="{StaticResource SettingLabelStyle}"
                               Text="Interaction mode" />
                    <UniformGrid Margin="0,0,0,12" Columns="3">
                        <Button Margin="0,0,4,0"
                                Click="EditMode_OnClick"
                                Content="Edit">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ActionButtonStyle}"
                                       TargetType="{x:Type Button}">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Background" Value="#3B48DCF9" />
                                            <Setter Property="BorderBrush" Value="#A548DCF9" />
                                            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="4,0"
                                Click="LockedMode_OnClick"
                                Content="Locked">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ActionButtonStyle}"
                                       TargetType="{x:Type Button}">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLockedMode}" Value="True">
                                            <Setter Property="Background" Value="#3B48DCF9" />
                                            <Setter Property="BorderBrush" Value="#A548DCF9" />
                                            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="4,0,0,0"
                                Click="ClickThroughMode_OnClick"
                                Content="Click-through">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ActionButtonStyle}"
                                       TargetType="{x:Type Button}">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClickThroughMode}" Value="True">
                                            <Setter Property="Background" Value="#3B48DCF9" />
                                            <Setter Property="BorderBrush" Value="#A548DCF9" />
                                            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <Button Click="LaunchStudio_OnClick"
                            Content="Open full Studio"
                            Style="{StaticResource ActionButtonStyle}" />

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            Background="{Binding TrackBrush}"
                            CornerRadius="10">
                        <TextBlock FontFamily="{Binding WidgetFontFamily}"
                                   FontSize="12"
                                   Foreground="{Binding TextSecondaryBrush}"
                                   Text="{Binding HotkeyHint}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
