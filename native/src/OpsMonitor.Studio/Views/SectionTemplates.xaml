                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Session timeline" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Margin="0,4,0,0" Text="Last 60 minutes · deterministic demo series" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource TagBorder}" Margin="0,0,7,0">
                                    <TextBlock Text="● CPU" Foreground="{StaticResource Brush.Accent}" FontSize="12"/>
