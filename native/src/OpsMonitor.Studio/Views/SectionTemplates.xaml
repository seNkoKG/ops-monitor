                                        <Polyline Stroke="{StaticResource Brush.Accent}" StrokeThickness="3" StrokeLineJoin="Round" Points="0,112 32,103 68,117 105,92 140,97 176,74 212,88 248,66 286,78 320,54 356,63 392,43 430,52 468,34 505,49 543,29 580,42 600,36"/>
                                        <Polyline Stroke="{StaticResource Brush.Magenta}" StrokeThickness="2.5" StrokeLineJoin="Round" Points="0,132 36,126 72,136 108,121 144,128 180,106 216,119 252,97 288,103 324,82 360,98 396,73 432,80 468,61 504,72 540,55 576,68 600,61"/>
                                        <Polyline Stroke="{StaticResource Brush.Blue}" StrokeThickness="2" StrokeLineJoin="Round" Points="0,85 50,83 100,82 150,80 200,79 250,77 300,76 350,75 400,74 450,72 500,73 550,71 600,70" Opacity="0.75"/>
