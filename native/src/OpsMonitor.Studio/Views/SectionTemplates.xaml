                                <controls:StudioSettingSlider Header="Shell radius" Description="Outer corner curve" Minimum="0" Maximum="48" SmallChange="1" Unit=" px" Value="{Binding CornerRadius}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Card radius" Description="Module corner curve" Minimum="0" Maximum="40" SmallChange="1" Unit=" px" Value="{Binding CardCornerRadius}"/>
