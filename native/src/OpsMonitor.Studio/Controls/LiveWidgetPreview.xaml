<UserControl x:Class="OpsMonitor.Studio.Controls.LiveWidgetPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="350">
    <Grid Background="#F2070A0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,20,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Height="12" Margin="0,2,8,0">
                        <Ellipse Fill="#2458E6B2"/>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Success}"/>
                    </Grid>
                    <TextBlock Text="LIVE CANVAS" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Brush.Success}"/>
                </StackPanel>
                <TextBlock Margin="0,7,0,0"
                           Text="Every control updates this preview and the widget."
                           Style="{StaticResource CaptionText}"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="9,5"
                    Background="{StaticResource Brush.Surface2}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding SelectedLayout, StringFormat={}{0} MODE}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="10"
                           Foreground="{StaticResource Brush.Accent}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Pill" Command="{Binding SelectLayoutCommand}" CommandParameter="Pill" Style="{StaticResource StudioButton}" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Rail" Command="{Binding SelectLayoutCommand}" CommandParameter="Rail" Style="{StaticResource StudioButton}" Margin="0,0,5,0"/>
            <Button Grid.Column="2" Content="Dock" Command="{Binding SelectLayoutCommand}" CommandParameter="Dock" Style="{StaticResource StudioButton}" Margin="0,0,5,0"/>
            <Button Grid.Column="3" Content="Mini" Command="{Binding SelectLayoutCommand}" CommandParameter="Mini" Style="{StaticResource StudioButton}"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,0,20,16"
                Background="#FF080B11"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FF080B11">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#18364A62" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>

                <Viewbox Margin="22" Stretch="Uniform">
                    <Border Width="{Binding PreviewWidth}"
                            Height="{Binding PreviewHeight}"
                            Background="{Binding PreviewSurfaceBrush}"
                            BorderBrush="{Binding PreviewBorderBrush}"
                            BorderThickness="{Binding Designer.BorderWidth}"
                            CornerRadius="{Binding Designer.CornerRadius}"
                            ClipToBounds="True">
                        <Grid Margin="{Binding Designer.ContentPadding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="3,2,3,7"
                                  Opacity="{Binding ContentOpacity}"
                                  Visibility="{Binding Designer.HeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLayout}" Value="Dock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="11" Height="11" Margin="0,0,7,0"
                                          Visibility="{Binding Designer.StatusIndicatorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Ellipse Stroke="#8858E6B2"/>
                                        <Ellipse Width="6" Height="6" Fill="#FF58E6B2"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PreviewTitle}"
                                               FontFamily="{Binding Designer.FontFamily}"
                                               FontSize="{Binding Designer.HeaderSize}"
                                               Foreground="{Binding Designer.PrimaryTextBrush}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="⚙"
                                           Foreground="{Binding Designer.SecondaryTextBrush}"
                                           FontSize="12"
                                           Visibility="{Binding Designer.SettingsButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>

                            <ItemsControl Grid.Row="1"
                                          Margin="-3"
                                          ItemsSource="{Binding Modules}"
                                          Opacity="{Binding ContentOpacity}"
                                          ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="{Binding DataContext.PreviewModuleWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   ItemHeight="{Binding DataContext.PreviewModuleHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border x:Name="DetailCard"
                                                    Margin="3"
                                                    Padding="{Binding PreviewCardPadding}"
                                                    Background="{Binding PreviewCardBrush}"
                                                    BorderBrush="{Binding PreviewBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{Binding PreviewCardCornerRadius}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="{Binding PreviewAccentWidth}" Margin="0,0,7,0" Background="{Binding Accent}" CornerRadius="2"
                                                            Visibility="{Binding ShowAccent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CustomIcon}" Margin="0,0,5,0" FontSize="{Binding PreviewIconSize}" Foreground="{Binding Accent}"
                                                                       Visibility="{Binding ShowIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CustomTitle}" FontSize="{Binding PreviewLabelSize}" FontWeight="SemiBold" Foreground="{Binding Accent}"
                                                                       Visibility="{Binding ShowLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="{Binding PreviewSecondaryValue}" FontSize="9"
                                                                       Foreground="{Binding DataContext.Designer.SecondaryTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Visibility="{Binding ShowTemperature, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding PreviewPrimaryValue}"
                                                                   FontFamily="{Binding DataContext.Designer.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   FontSize="{Binding PreviewValueSize}" FontWeight="SemiBold"
                                                                   Foreground="{Binding DataContext.Designer.PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Grid Grid.Row="2" Height="{Binding PreviewProgressHeight}" Margin="0,3,0,0">
                                                            <Border Background="#55364258" CornerRadius="2"/>
                                                            <Border Width="{Binding UsagePercent}" MaxWidth="100" HorizontalAlignment="Left" Background="{Binding Accent}" CornerRadius="2"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="CompactCard"
                                                    Margin="1.5"
                                                    Padding="{Binding PreviewCardPadding}"
                                                    Background="{Binding PreviewCardBrush}"
                                                    BorderBrush="{Binding PreviewBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{Binding PreviewCardCornerRadius}"
                                                    Visibility="Collapsed"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="{Binding PreviewAccentWidth}" Margin="0,0,5,0" Background="{Binding Accent}" CornerRadius="2"
                                                            Visibility="{Binding ShowAccent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CustomIcon}" Margin="0,0,4,0" FontSize="{Binding PreviewCompactIconSize}" Foreground="{Binding Accent}" VerticalAlignment="Center"
                                                                       Visibility="{Binding ShowIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CustomTitle}" FontSize="{Binding PreviewCompactLabelSize}" FontWeight="SemiBold" Foreground="{Binding Accent}" VerticalAlignment="Center"
                                                                       Visibility="{Binding ShowLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Grid.Column="2" Margin="5,0,0,0" Text="{Binding PreviewSecondaryValue}" FontSize="8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding DataContext.Designer.SecondaryTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Visibility="{Binding ShowTemperature, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding PreviewPrimaryValue}"
                                                                   FontFamily="{Binding DataContext.Designer.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   FontSize="{Binding PreviewCompactValueSize}" FontWeight="SemiBold"
                                                                   Foreground="{Binding DataContext.Designer.PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SelectedLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Mini">
                                                <Setter TargetName="DetailCard" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CompactCard" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataContext.SelectedLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Rail"/>
                                                    <Condition Binding="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="DetailCard" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CompactCard" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,6,0" Padding="12,9" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <StackPanel><TextBlock Text="ALWAYS ON TOP" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,3,50,0" Text="Window priority" Style="{StaticResource CaptionText}"/></StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Always on top"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="12,9" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <StackPanel><TextBlock Text="POSITION LOCK" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,3,50,0" Text="Prevent movement" Style="{StaticResource CaptionText}"/></StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding PositionLocked}" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Position lock"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
