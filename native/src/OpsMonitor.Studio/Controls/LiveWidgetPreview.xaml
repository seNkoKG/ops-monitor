<UserControl x:Class="OpsMonitor.Studio.Controls.LiveWidgetPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgetControls="clr-namespace:OpsMonitor.Widget.Controls;assembly=OpsMonitor.Widget"
             MinWidth="350">
    <Grid Background="#F2070A0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,20,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Height="12" Margin="0,2,8,0">
                        <Ellipse Fill="#2458E6B2"/>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Success}"/>
                    </Grid>
                    <TextBlock Text="LIVE CANVAS" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Brush.Success}"/>
                </StackPanel>
                <TextBlock Margin="0,7,0,0"
                           Text="Every control updates this preview and the widget."
                           Style="{StaticResource CaptionText}"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="9,5"
                    Background="{StaticResource Brush.Surface2}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding SelectedLayout, StringFormat={}{0} MODE}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="10"
                           Foreground="{StaticResource Brush.Accent}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Pill" Command="{Binding SelectLayoutCommand}" CommandParameter="Pill" Style="{StaticResource StudioButton}" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Rail" Command="{Binding SelectLayoutCommand}" CommandParameter="Rail" Style="{StaticResource StudioButton}" Margin="0,0,5,0"/>
            <Button Grid.Column="2" Content="Dock" Command="{Binding SelectLayoutCommand}" CommandParameter="Dock" Style="{StaticResource StudioButton}" Margin="0,0,5,0"/>
            <Button Grid.Column="3" Content="Mini" Command="{Binding SelectLayoutCommand}" CommandParameter="Mini" Style="{StaticResource StudioButton}"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,0,20,16"
                Background="#FF0B111A"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FF0B111A">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#2B36506B" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>

                <Viewbox Margin="22" Stretch="Uniform">
                    <Grid>
                    <Border Width="{Binding PreviewWidth}"
                            Height="{Binding PreviewHeight}"
                            Background="{Binding PreviewSurfaceBrush}"
                            BorderBrush="{Binding PreviewBorderBrush}"
                            BorderThickness="{Binding Designer.BorderWidth}"
                            CornerRadius="{Binding Designer.CornerRadius}"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              Direction="270"
                                              Opacity="{Binding PreviewShellShadowOpacity}"
                                              ShadowDepth="5"
                                              Color="#FF000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Margin" Value="{Binding LayoutShellContentPadding}"/>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="2"
                                    Height="72"
                                    VerticalAlignment="Top"
                                    Background="{Binding PreviewShellGlowBrush}"
                                    CornerRadius="25,25,0,0"
                                    Opacity="{Binding PreviewShellGlowOpacity}"
                                    IsHitTestVisible="False"/>

                            <Grid Opacity="{Binding ContentOpacity}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="3,2,3,7"/>
                                        <Setter Property="Height" Value="{Binding LayoutHeaderHeight}"/>
                                        <Setter Property="Visibility" Value="{Binding Designer.HeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLayout}" Value="Dock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedLayout}" Value="Mini">
                                                <Setter Property="Margin" Value="8,1,7,0"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedLayout}" Value="Mini"/>
                                                    <Condition Binding="{Binding Density}" Value="Compact"/>
                                                    <Condition Binding="{Binding IsReducedScale}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Margin" Value="6,0,5,0"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="11" Height="11" Margin="0,0,7,0"
                                          Visibility="{Binding Designer.StatusIndicatorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Ellipse Stroke="{Binding Designer.SuccessBrush}" Opacity="0.55"/>
                                        <Ellipse Width="6" Height="6" Fill="{Binding Designer.SuccessBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding PreviewTitle}"
                                               FontFamily="{Binding Designer.FontFamily}"
                                               FontSize="{Binding LayoutHeaderFontSize}"
                                               Foreground="{Binding Designer.PrimaryTextBrush}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="⚙"
                                           Foreground="{Binding Designer.SecondaryTextBrush}"
                                           FontSize="12"
                                           Visibility="{Binding Designer.SettingsButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>

                            <ItemsControl Grid.Row="1"
                                          Margin="0"
                                          ItemsSource="{Binding VisibleModulesView}"
                                          Opacity="{Binding ContentOpacity}"
                                          ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="{Binding DataContext.PreviewModuleWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   ItemHeight="{Binding DataContext.PreviewModuleHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <widgetControls:MetricCard DataContext="{Binding ProductionCard}"
                                                                       Layout="{Binding DataContext.PreviewWidgetLayout, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Density="{Binding DataContext.PreviewWidgetDensity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       ContentOpacity="{Binding DataContext.ContentOpacity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       ThemeContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <Border Width="{Binding PreviewWidth}"
                            Height="{Binding PreviewHeight}"
                            BorderBrush="#3458DCEB"
                            BorderThickness="1"
                            CornerRadius="{Binding Designer.CornerRadius}"
                            IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,6,0" Padding="12,9" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <StackPanel><TextBlock Text="ALWAYS ON TOP" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,3,50,0" Text="Window priority" Style="{StaticResource CaptionText}"/></StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Always on top"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="12,9" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <StackPanel><TextBlock Text="POSITION LOCK" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,3,50,0" Text="Prevent movement" Style="{StaticResource CaptionText}"/></StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding PositionLocked}" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Position lock"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
