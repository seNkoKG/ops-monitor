<Window x:Class="OpsMonitor.Widget.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpsMonitor.Widget.Controls"
        Title="OPS Weather"
        Width="1080"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed">
    <Window.Resources>
        <SolidColorBrush x:Key="WeatherSurface" Color="#F1080C14" />
        <SolidColorBrush x:Key="WeatherCard" Color="#D9161E2C" />
        <SolidColorBrush x:Key="WeatherCardSoft" Color="#99101825" />
        <SolidColorBrush x:Key="WeatherBorder" Color="#4A5C789A" />
        <SolidColorBrush x:Key="WeatherText" Color="#FFF6FAFF" />
        <SolidColorBrush x:Key="WeatherMuted" Color="#FF9CAFC7" />
        <SolidColorBrush x:Key="WeatherCyan" Color="#FF48DCF9" />
        <SolidColorBrush x:Key="WeatherBlue" Color="#FF4C8DFF" />
        <SolidColorBrush x:Key="WeatherGreen" Color="#FF58E6B2" />
        <SolidColorBrush x:Key="WeatherAmber" Color="#FFFFC35A" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable" />
            <Setter Property="Foreground" Value="{StaticResource WeatherText}" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WeatherMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource WeatherMuted}" />
        </Style>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WeatherCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource WeatherBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="WeatherButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{StaticResource WeatherText}" />
            <Setter Property="Background" Value="#251F3045" />
            <Setter Property="BorderBrush" Value="{StaticResource WeatherBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#48334B68" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AA48DCF9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StripChevronButton" TargetType="Button" BasedOn="{StaticResource WeatherButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource WeatherMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Padding="{TemplateBinding Padding}" CornerRadius="11">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#263BCEF0" />
                                <Setter Property="Foreground" Value="{StaticResource WeatherCyan}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#1DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource WeatherSurface}"
            BorderBrush="#465B7395"
            BorderThickness="1"
            CornerRadius="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" Direction="270" Opacity="0.7" ShadowDepth="8" Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Grid Margin="24,12,16,8" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="38" Height="38" Margin="0,0,12,0">
                    <Ellipse Fill="#1F48DCF9" />
                    <Ellipse Width="26" Height="26" Fill="#1648DCF9">
                        <Ellipse.Effect>
                            <BlurEffect Radius="9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <controls:WeatherIcon Width="32" Height="32"
                                          WeatherCode="{Binding Current.WeatherCode}"
                                          IsDay="{Binding Current.IsDayValue}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="OPS WEATHER" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}"
                               Text="ARSO observations · 3-model forecast · 15-minute detail" />
                </StackPanel>

                <Grid x:Name="LocationSearchHost" Grid.Column="2" Margin="14,0">
                    <Border Background="#B40C121D" BorderBrush="{StaticResource WeatherBorder}"
                            BorderThickness="1" CornerRadius="13" />
                    <Grid Margin="13,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource WeatherCyan}"
                                   FontSize="15" Text="⌖" />
                        <TextBox x:Name="LocationSearchBox" Grid.Column="1" Margin="9,0"
                                 VerticalContentAlignment="Center" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource WeatherText}"
                                 CaretBrush="{StaticResource WeatherCyan}"
                                 FontSize="13" Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="LocationSearchBox_OnKeyDown"
                                 ToolTip="Search any town or postcode" />
                        <Button Grid.Column="2" Width="34" Height="30" Padding="0"
                                Click="SearchButton_OnClick" Style="{StaticResource WeatherButton}"
                                ToolTip="Find location" Content="↵" />
                    </Grid>
                    <Popup Width="390"
                           AllowsTransparency="True"
                           HorizontalOffset="0"
                           IsOpen="{Binding IsSearchOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=LocationSearchHost}"
                           StaysOpen="False"
                           VerticalOffset="7">
                        <Border Padding="7"
                                Background="#FB0B1019"
                                BorderBrush="{StaticResource WeatherBorder}"
                                BorderThickness="1"
                                CornerRadius="13">
                            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,1" Padding="10,8" HorizontalContentAlignment="Left"
                                                    Click="LocationResult_OnClick" Style="{StaticResource WeatherButton}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}"
                                                               Text="{Binding DisplayName}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="3" Width="40" Height="40" Margin="0,0,8,0" Padding="0"
                        Click="RefreshButton_OnClick" Style="{StaticResource WeatherButton}"
                        ToolTip="Refresh now" Content="↻" FontSize="17" />
                <Button Grid.Column="4" Width="40" Height="40" Padding="0"
                        Click="CloseButton_OnClick" Style="{StaticResource WeatherButton}"
                        ToolTip="Close" Content="✕" />
            </Grid>

            <TabControl x:Name="WeatherTabs" Grid.Row="1" Margin="18,0,18,0"
                        Background="Transparent" BorderThickness="0"
                        SelectionChanged="WeatherTabs_OnSelectionChanged">
                <TabItem Header="OVERVIEW">
                    <ScrollViewer x:Name="OverviewScroller" Margin="0,12,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="6,0,6,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.18*" />
                                    <ColumnDefinition Width="0.82*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,7,0" Padding="26" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="146" Height="146">
                                            <Ellipse x:Name="HeroGlow" Fill="#1748DCF9">
                                                <Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse x:Name="HeroGlowCore" Fill="#2848DCF9">
                                                <Ellipse.Effect><BlurEffect Radius="30" /></Ellipse.Effect>
                                            </Ellipse>
                                            <controls:WeatherIcon Width="132" Height="132"
                                                                  WeatherCode="{Binding Current.WeatherCode}"
                                                                  IsDay="{Binding Current.IsDayValue}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="24,5,0,0" VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource WeatherCyan}" FontSize="14"
                                                       FontWeight="SemiBold" Text="{Binding Current.Location.DisplayName}" />
                                            <TextBlock Margin="0,-4,0,-4" FontSize="72" FontWeight="Light"
                                                       Text="{Binding Current.TemperatureLabel}" />
                                            <TextBlock FontSize="20" FontWeight="SemiBold"
                                                       Text="{Binding Current.Condition}" />
                                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Current.FeelsLikeLabel}" />
                                                <TextBlock Margin="8,0" Style="{StaticResource MutedText}" Text="·" />
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Current.ObservationSource}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <Border Padding="8,4" Background="#2458E6B2" CornerRadius="8">
                                                    <TextBlock Foreground="{StaticResource WeatherGreen}" FontSize="10"
                                                               FontWeight="Bold" Text="{Binding Current.Confidence.Label}" />
                                                </Border>
                                                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedText}"
                                                           Text="{Binding Current.Confidence.Detail}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Margin="7,0,0,0" Padding="20" Style="{StaticResource GlassCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="LIVE CONDITIONS" />
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                                           Text="{Binding Current.StationName}" />
                                                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource WeatherCyan}" FontSize="9"
                                                           Text="{Binding Current.CoordinateLabel}" />
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid Grid.Row="1" Margin="0,16,0,0" Columns="2" Rows="6">
                                            <StackPanel Margin="0,0,10,12">
                                                <TextBlock Style="{StaticResource MutedText}" Text="HUMIDITY" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.HumidityLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,12">
                                                <TextBlock Style="{StaticResource MutedText}" Text="WIND" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.WindLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,6,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="RAIN NEXT HOUR" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WeatherCyan}" Text="{Binding Current.RainLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,6,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="PRESSURE" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.PressureLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,12,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="UV INDEX" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WeatherAmber}"
                                                           Text="{Binding Current.UvIndexLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,12,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="DEW POINT" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.DewPointLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,12,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="VISIBILITY" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.VisibilityLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,12,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="CLOUD COVER" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.CloudLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,12,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="SNOW DEPTH" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WeatherBlue}"
                                                           Text="{Binding Current.SnowDepthLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,12,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="FREEZING LEVEL" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.FreezingLevelLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,12,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="WIND GUST" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.GustLabel}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,12,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="SOIL TEMP" />
                                                <TextBlock Margin="0,3,0,0" FontSize="21" FontWeight="SemiBold"
                                                           Text="{Binding Current.SoilTemperatureLabel}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0" Padding="18" Style="{StaticResource GlassCard}"
                                    Visibility="{Binding AlertVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Background="#30FFC35A" CornerRadius="12">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource WeatherAmber}" FontSize="21" Text="⚠" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="13,0">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Current.Alert.Headline}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}"
                                                   Text="Official ARSO warning for this region" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="10,5" VerticalAlignment="Center"
                                            Background="#29FFC35A" CornerRadius="9">
                                        <TextBlock Foreground="{StaticResource WeatherAmber}" FontSize="11"
                                                   FontWeight="Bold" Text="{Binding Current.Alert.LevelLabel}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="18,14" Style="{StaticResource GlassCard}"
                                    Visibility="{Binding OfficialOutlookVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" Background="#2248DCF9" CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource WeatherCyan}" FontSize="17" Text="◎" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Text="{Binding Current.OfficialOutlook.Summary}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}"
                                                   Text="Official national-service regional outlook" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Foreground="{StaticResource WeatherCyan}" FontSize="11"
                                               Text="{Binding Current.OfficialOutlook.SourceLabel}" />
                                </Grid>
                            </Border>

                            <Grid Margin="2,18,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="NEXT 4 HOURS · 15-MINUTE RAIN" />
                                <Button x:Name="NowcastScrollLeft" Grid.Column="1" Click="NowcastScrollLeft_OnClick" Style="{StaticResource StripChevronButton}" Content="‹" ToolTip="Scroll nowcast left" />
                                <Button x:Name="NowcastScrollRight" Grid.Column="2" Click="NowcastScrollRight_OnClick" Style="{StaticResource StripChevronButton}" Content="›" ToolTip="Scroll nowcast right" />
                            </Grid>
                            <ScrollViewer x:Name="NowcastScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                          ScrollChanged="HorizontalStrip_OnScrollChanged"
                                          PreviewMouseWheel="HorizontalStrip_OnPreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding Nowcast}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="86" Margin="0,0,7,0" Padding="10,9" Style="{StaticResource GlassCard}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}"
                                                               Text="{Binding TimeLabel}" />
                                                    <controls:WeatherIcon Width="42" Height="42" Margin="0,2,0,0"
                                                               WeatherCode="{Binding WeatherCode}"
                                                               IsDay="{Binding IsDayValue}"
                                                               Subtle="True" />
                                                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource WeatherCyan}"
                                                               FontSize="12" FontWeight="SemiBold" Text="{Binding RainLabel}" />
                                                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherMuted}" FontSize="9"
                                                               Text="{Binding ConfidenceScore, StringFormat={}{0}% agree}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Margin="2,18,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="NEXT 24 HOURS" />
                                <Button x:Name="HourlyScrollLeft" Grid.Column="1" Click="HourlyScrollLeft_OnClick" Style="{StaticResource StripChevronButton}" Content="‹" ToolTip="Scroll hourly forecast left" />
                                <Button x:Name="HourlyScrollRight" Grid.Column="2" Click="HourlyScrollRight_OnClick" Style="{StaticResource StripChevronButton}" Content="›" ToolTip="Scroll hourly forecast right" />
                            </Grid>
                            <ScrollViewer x:Name="HourlyScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                          ScrollChanged="HorizontalStrip_OnScrollChanged"
                                          PreviewMouseWheel="HorizontalStrip_OnPreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding Hourly}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="116" Margin="0,0,8,0" Padding="12" Style="{StaticResource GlassCard}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}"
                                                               Text="{Binding TimeLabel}" />
                                                    <controls:WeatherIcon Width="52" Height="52" Margin="0,2,0,0"
                                                               WeatherCode="{Binding WeatherCode}"
                                                               IsDay="{Binding IsDayValue}"
                                                               Subtle="True" />
                                                    <TextBlock HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold"
                                                               Text="{Binding TemperatureLabel}" />
                                                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherCyan}" FontSize="11"
                                                               Text="{Binding RainLabel}" />
                                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherMuted}" FontSize="9"
                                                               Text="{Binding DetailLabel}" />
                                                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherMuted}" FontSize="9"
                                                               Text="{Binding PressureLabel}" />
                                                    <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherAmber}" FontSize="9"
                                                               Text="{Binding UvLabel}" />
                                                    <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherBlue}" FontSize="9"
                                                               Text="{Binding SnowLabel}" />
                                                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource WeatherGreen}" FontSize="9"
                                                               Text="{Binding ConfidenceLabel, StringFormat={}AGREE {0}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Margin="2,18,0,9" Style="{StaticResource SectionTitle}" Text="8-DAY OUTLOOK" />
                            <ItemsControl ItemsSource="{Binding Daily}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7" Padding="15,10" Style="{StaticResource GlassCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="175" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DayLabel}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource WeatherAmber}"
                                                               FontSize="9" Text="{Binding DaylightLabel}" />
                                                </StackPanel>
                                                <controls:WeatherIcon Grid.Column="1" Width="48" Height="48"
                                                           VerticalAlignment="Center"
                                                           WeatherCode="{Binding WeatherCode}"
                                                           IsDay="True"
                                                           Subtle="True" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding RangeLabel}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource WeatherBlue}"
                                                               FontSize="9" Text="{Binding SnowLabel}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource WeatherCyan}"
                                                           Text="{Binding RainLabel}" />
                                                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedText}"
                                                           Text="{Binding WindLabel}" />
                                                <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource WeatherGreen}" FontSize="10"
                                                           Text="{Binding ConfidenceLabel}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="RadarTab" Header="LIVE RADAR">
                    <Grid Margin="6,12,6,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="16,11" Style="{StaticResource GlassCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="ARSO PRECIPITATION COMPOSITE" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}"
                                               Text="Official Slovenia radar · 5-minute source cadence · 90-minute animation" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource MutedText}"
                                               Text="ZOOM" />
                                    <Slider Width="120" Minimum="0.6" Maximum="2.2" Value="{Binding RadarZoom, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,10" Background="#FF05080D"
                                BorderBrush="{StaticResource WeatherBorder}" BorderThickness="1" CornerRadius="18"
                                ClipToBounds="True">
                            <Grid>
                                <ScrollViewer HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PanningMode="Both">
                                    <Grid>
                                        <Image x:Name="RadarImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding RadarZoom}" ScaleY="{Binding RadarZoom}" />
                                            </Image.LayoutTransform>
                                        </Image>
                                    </Grid>
                                </ScrollViewer>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource WeatherMuted}" FontSize="14"
                                           Text="{Binding RadarStatus}" Visibility="{Binding RadarStatusVisibility}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Padding="14,10" Style="{StaticResource GlassCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Button Width="92" Click="RadarPlayButton_OnClick" Style="{StaticResource WeatherButton}"
                                        Content="{Binding RadarPlayLabel}" />
                                <Slider x:Name="RadarTimeline" Grid.Column="1" Margin="15,0" Minimum="0" Maximum="1"
                                        IsSnapToTickEnabled="True" ValueChanged="RadarTimeline_OnValueChanged" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource MutedText}" Text="{Binding RadarFrameLabel}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="AIR &amp; SUN">
                    <ScrollViewer Margin="6,12,6,12" VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,0,7,0" Padding="24" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="EUROPEAN AIR QUALITY INDEX" />
                                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                            <TextBlock FontSize="60" FontWeight="Light" Foreground="{StaticResource WeatherGreen}"
                                                       Text="{Binding Current.AirQuality.EuropeanAqi, TargetNullValue=N/A}" />
                                            <StackPanel Margin="18,10,0,0">
                                                <TextBlock FontSize="22" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.AqiLabel}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}"
                                                           Text="CAMS European atmospheric model" />
                                            </StackPanel>
                                        </StackPanel>
                                        <UniformGrid Margin="0,24,0,0" Columns="2">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" Text="PM2.5" />
                                                <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.Pm25, StringFormat={}{0:0.0} μg/m³, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" Text="PM10" />
                                                <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.Pm10, StringFormat={}{0:0.0} μg/m³, TargetNullValue=N/A}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <UniformGrid Margin="0,14,0,0" Columns="4">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="NO₂" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.NitrogenDioxide, StringFormat={}{0:0.0} μg/m³, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="O₃" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.Ozone, StringFormat={}{0:0.0} μg/m³, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="SO₂" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.SulphurDioxide, StringFormat={}{0:0.0} μg/m³, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" Text="CO" />
                                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.CarbonMonoxide, StringFormat={}{0:0.0} mg/m³, TargetNullValue=N/A}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Margin="7,0,0,0" Padding="24" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="UV &amp; POLLEN" />
                                        <UniformGrid Margin="0,18,0,0" Columns="2" Rows="2">
                                            <StackPanel Margin="0,0,10,20">
                                                <TextBlock Style="{StaticResource MutedText}" Text="UV INDEX" />
                                                <TextBlock Margin="0,4,0,0" FontSize="25" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WeatherAmber}"
                                                           Text="{Binding Current.AirQuality.UvIndex, StringFormat={}{0:0.0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,20">
                                                <TextBlock Style="{StaticResource MutedText}" Text="GRASS POLLEN" />
                                                <TextBlock Margin="0,4,0,0" FontSize="25" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.GrassPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="BIRCH POLLEN" />
                                                <TextBlock Margin="0,4,0,0" FontSize="25" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.BirchPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="TODAY MAX UV" />
                                                <TextBlock Margin="0,4,0,0" FontSize="25" FontWeight="SemiBold"
                                                           Text="{Binding Daily[0].UvIndex, StringFormat={}{0:0.0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <UniformGrid Margin="0,10,0,0" Columns="2" Rows="2">
                                            <StackPanel Margin="0,0,10,12">
                                                <TextBlock Style="{StaticResource MutedText}" Text="ALDER POLLEN" />
                                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.AlderPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,12">
                                                <TextBlock Style="{StaticResource MutedText}" Text="OLIVE POLLEN" />
                                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.OlivePollen, StringFormat={}{0:0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="RAGWEED POLLEN" />
                                                <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                                           Text="{Binding Current.AirQuality.RagweedPollen, StringFormat={}{0:0}, TargetNullValue=N/A}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0" Padding="24" Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="SUNRISE" />
                                        <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Light"
                                                   Text="{Binding Daily[0].Sunrise, StringFormat={}{0:HH:mm}, TargetNullValue=N/A}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="SUNSET" />
                                        <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Light"
                                                   Text="{Binding Daily[0].Sunset, StringFormat={}{0:HH:mm}, TargetNullValue=N/A}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="DAYLIGHT" />
                                        <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Light"
                                                   Text="{Binding DaylightLabel}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="25,0,25,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}"
                           Text="{Binding StatusText}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MutedText}"
                           Text="ARSO observations/warnings/radar · Open-Meteo Best Match + ECMWF + ICON · CAMS air" />
            </Grid>
        </Grid>
    </Border>
</Window>
