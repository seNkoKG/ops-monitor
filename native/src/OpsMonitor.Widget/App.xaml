<Application x:Class="OpsMonitor.Widget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DropShadowEffect x:Key="WidgetTextHalo"
                          BlurRadius="2"
                          Color="#FF000000"
                          Opacity="1"
                          RenderingBias="Performance"
                          ShadowDepth="0" />
        <Style x:Key="WidgetReadableText" TargetType="{x:Type TextBlock}">
            <Setter Property="Effect" Value="{StaticResource WidgetTextHalo}" />
        </Style>
    </Application.Resources>
</Application>
