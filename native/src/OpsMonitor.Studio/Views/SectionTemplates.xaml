                                      IsEnabled="False"
                                      ToolTip="History export is not available in v2.0.">
                                <ComboBoxItem Content="CSV · universal"/>
                                <ComboBoxItem Content="JSON · full fidelity"/>
                                <ComboBoxItem Content="Prometheus text"/>
                            </ComboBox>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button Content="Export visible range"
                                        IsEnabled="False"
                                        ToolTip="History export is not available in v2.0."
