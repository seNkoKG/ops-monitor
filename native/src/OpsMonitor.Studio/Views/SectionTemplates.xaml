                            <controls:StudioSettingField Margin="0,0,8,12" Header="CPU" Description="Processor" Text="{Binding CpuAccent}" ShowSwatch="True" SwatchBrush="{Binding CpuAccentBrush}"/>
                            <controls:StudioSettingField Margin="8,0,8,12" Header="GPU" Description="Graphics" Text="{Binding GpuAccent}" ShowSwatch="True" SwatchBrush="{Binding GpuAccentBrush}"/>
