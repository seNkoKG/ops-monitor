<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindow"
    Title="Performance Pill"
    Width="184"
    Height="396"
    MinWidth="147"
    MinHeight="317"
    MaxWidth="276"
    MaxHeight="594"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    FontFamily="Segoe UI"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF5F7FA"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#FFA3ADBC"/>
        <SolidColorBrush x:Key="MutedText" Color="#FF667184"/>
        <SolidColorBrush x:Key="CardBrush" Color="#B51E2531"/>
        <SolidColorBrush x:Key="CardStroke" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#FF58DFFF"/>
        <SolidColorBrush x:Key="MagentaAccent" Color="#FFF05BEA"/>
        <SolidColorBrush x:Key="MintAccent" Color="#FF51E5C2"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF73E0FF" Offset="0"/>
            <GradientStop Color="#FF788BFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="10,0,10,5"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#367B91FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" CornerRadius="2">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox x:Name="ScaleViewbox" Stretch="Fill">
        <Grid x:Name="DesignCanvas" Width="184" Height="396">
            <Grid x:Name="PillDesign">
            <Border x:Name="Shell"
                    Margin="4"
                    CornerRadius="27"
                    Background="#E012151C"
                    BorderBrush="#32FFFFFF"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.42" Color="#FF000000"/>
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="17"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderDragZone" Grid.Row="0" Margin="15,5,11,3" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF5EE6A8" Margin="0,0,8,0"/>
                                <TextBlock Text="PERFORMANCE" Style="{StaticResource LabelText}" Foreground="#FFC9D1DC"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdatedText" Text="Starting…" Foreground="{StaticResource MutedText}" FontSize="8" Margin="15,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LockBadge"
                                       Text="●"
                                       Foreground="#FFFFC66D"
                                       FontSize="10"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       ToolTip="Position is locked"/>
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource IconButton}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Content="&#xE713;"
                                    ToolTip="Settings"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Border Style="{StaticResource MetricCard}" BorderBrush="#3858DFFF">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#2058DFFF" BorderBrush="#6B58DFFF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Grid Width="13" Height="13">
                                            <Rectangle Width="8" Height="8" Stroke="{StaticResource CyanAccent}" StrokeThickness="1.2"/>
                                            <Path Data="M1,0 L1,3 M5,0 L5,3 M9,0 L9,3 M13,0 L13,3 M1,10 L1,13 M5,10 L5,13 M9,10 L9,13 M13,10 L13,13 M0,1 L3,1 M0,5 L3,5 M0,9 L3,9 M0,13 L3,13 M10,1 L13,1 M10,5 L13,5 M10,9 L13,9 M10,13 L13,13" Stroke="{StaticResource CyanAccent}" StrokeThickness="1"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CpuLabel" Text="CPU" Style="{StaticResource LabelText}" Foreground="{StaticResource CyanAccent}"/>
                                        <TextBlock x:Name="CpuValueText" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel x:Name="CpuTempPanel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="TEMP" Style="{StaticResource LabelText}" Foreground="#FF728193" FontSize="7" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="CpuTempText" Text="N/A" Foreground="#FFD7E3EF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Polyline x:Name="CpuSparkline" Stroke="#6A58DFFF" StrokeThickness="1" Points="0,4 21,3 42,4 64,2 86,3 107,1 128,2" VerticalAlignment="Top"/>
                                    <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource CyanAccent}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricCard}" BorderBrush="#3AF05BEA">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#20F05BEA" BorderBrush="#70F05BEA" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Grid Width="14" Height="11">
                                            <Rectangle Width="13" Height="9" Stroke="{StaticResource MagentaAccent}" StrokeThickness="1.1" RadiusX="1.5" RadiusY="1.5"/>
                                            <Ellipse Width="4" Height="4" Stroke="{StaticResource MagentaAccent}" StrokeThickness="1" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                            <Ellipse Width="4" Height="4" Stroke="{StaticResource MagentaAccent}" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="GpuLabel" Text="GPU" Style="{StaticResource LabelText}" Foreground="{StaticResource MagentaAccent}"/>
                                        <TextBlock x:Name="GpuValueText" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel x:Name="GpuTempPanel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="TEMP" Style="{StaticResource LabelText}" Foreground="#FF728193" FontSize="7" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="GpuTempText" Text="N/A" Foreground="#FFF2D6F0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Polyline x:Name="GpuSparkline" Stroke="#72F05BEA" StrokeThickness="1" Points="0,4 21,3 42,5 64,2 86,4 107,1 128,3" VerticalAlignment="Top"/>
                                    <ProgressBar x:Name="GpuBar" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource MagentaAccent}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricCard}" BorderBrush="#3851E5C2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#2051E5C2" BorderBrush="#6B51E5C2" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Grid Width="13" Height="10">
                                            <Rectangle Width="13" Height="7" Stroke="{StaticResource MintAccent}" StrokeThickness="1.1" VerticalAlignment="Top"/>
                                            <Path Data="M2,7 L2,10 M5,7 L5,10 M8,7 L8,10 M11,7 L11,10" Stroke="{StaticResource MintAccent}" StrokeThickness="1"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="MemoryLabel" Text="RAM · GB" Style="{StaticResource LabelText}" Foreground="{StaticResource MintAccent}"/>
                                        <TextBlock x:Name="MemoryText" Text="-- / --" Foreground="{StaticResource PrimaryText}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="USED" Style="{StaticResource LabelText}" Foreground="#FF728193" FontSize="7" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="MemoryPercentText" Text="--%" Foreground="#FFD2E7DF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="MemoryBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource MintAccent}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricCard}" BorderBrush="#3658DFFF">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="6" Background="#2058DFFF" BorderBrush="#6B58DFFF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Grid Width="13" Height="13">
                                        <Path Data="M2,2 L2,10 M2,2 L0,4 M2,2 L4,4 M10,11 L10,3 M10,11 L8,9 M10,11 L12,9" Stroke="{StaticResource CyanAccent}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NetworkLabel" Text="DOWN" Style="{StaticResource LabelText}" Foreground="{StaticResource MintAccent}" FontSize="7"/>
                                    <TextBlock x:Name="DownloadText" Text="0 KB/s" Foreground="{StaticResource PrimaryText}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#20FFFFFF" Margin="3,5"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="7,0,0,0">
                                    <TextBlock Text="UP" Style="{StaticResource LabelText}" Foreground="#FF9DA9FF" FontSize="7"/>
                                    <TextBlock x:Name="UploadText" Text="0 KB/s" Foreground="{StaticResource PrimaryText}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricCard}" Margin="10,0,10,0" BorderBrush="#2CFFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="6" Background="#18FFC66D" BorderBrush="#55FFC66D" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Path Data="M2,7 L4,7 L5.5,3 L8,11 L10,6 L12,6" Stroke="#FFFFC66D" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LatencyLabel" Text="PING" Style="{StaticResource LabelText}" Foreground="#FFFFC66D"/>
                                    <TextBlock x:Name="PingText" Text="-- ms" Foreground="{StaticResource PrimaryText}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="LOSS" Style="{StaticResource LabelText}" FontSize="7" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="PacketLossText" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="17,0,14,2">
                        <TextBlock x:Name="HintText"
                                   Text="DRAG TO MOVE"
                                   Style="{StaticResource LabelText}"
                                   Foreground="#FF4E5969"
                                   FontSize="7"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Thumb x:Name="ResizeThumb"
                   Width="22"
                   Height="22"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   Background="Transparent"
                   Margin="0,0,4,4"
                   ToolTip="Drag to resize">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 7,15 L 15,7 M 11,15 L 15,11"
                                  Stroke="#71818E9D"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            </Grid>

            <!-- Ultra-narrow, continuous rail: no floating cards, only fine dividers and accent rails. -->
            <Grid x:Name="RailDesign" Visibility="Collapsed">
                <Border x:Name="RailShell"
                        Margin="4"
                        CornerRadius="23"
                        Background="#E012151C"
                        BorderBrush="{DynamicResource CardStroke}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="#FF000000"/>
                    </Border.Effect>
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="RailHeaderDragZone" Margin="23,4,12,0" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="RailStatusDot" Width="6" Height="6" Fill="{StaticResource MintAccent}" Margin="0,0,7,0"/>
                                <StackPanel>
                                    <TextBlock Text="SYSTEM RAIL" Foreground="#FFD8DFE9" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RailUpdatedText" Text="Starting…" Foreground="{StaticResource MutedText}" FontSize="7"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="RailLockBadge" Text="●" Foreground="#FFFFC66D" FontSize="8" Margin="0,0,4,0" Visibility="Collapsed"/>
                                <Button x:Name="RailSettingsButton"
                                        Style="{StaticResource IconButton}"
                                        Width="22"
                                        Height="22"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="11"
                                        Content="&#xE713;"
                                        ToolTip="Settings"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0" ToolTip="CPU load and temperature">
                                <Border Width="2" CornerRadius="1" Background="{StaticResource CyanAccent}" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                <Grid Margin="8,3,2,3">
                                    <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▦" Grid.RowSpan="2" Foreground="{StaticResource CyanAccent}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailCpuLabel" Grid.Column="1" Text="CPU" Foreground="{StaticResource CyanAccent}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailCpuValueText" Grid.Row="1" Grid.Column="1" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" LineHeight="19" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                                    <Grid x:Name="RailCpuTempPanel" Grid.Column="2" Grid.RowSpan="2">
                                        <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="TEMP" Foreground="{StaticResource MutedText}" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RailCpuTempText" Grid.Row="1" Text="N/A" Foreground="#FFD9E5F0" FontSize="12" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="1" Margin="2,0" ToolTip="GPU load and temperature">
                                <Border Background="{DynamicResource CardStroke}" Height="1" VerticalAlignment="Top"/>
                                <Border Width="2" CornerRadius="1" Background="{StaticResource MagentaAccent}" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                <Grid Margin="8,3,2,3">
                                    <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▣" Grid.RowSpan="2" Foreground="{StaticResource MagentaAccent}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailGpuLabel" Grid.Column="1" Text="GPU" Foreground="{StaticResource MagentaAccent}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailGpuValueText" Grid.Row="1" Grid.Column="1" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" LineHeight="19" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                                    <Grid x:Name="RailGpuTempPanel" Grid.Column="2" Grid.RowSpan="2">
                                        <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="TEMP" Foreground="{StaticResource MutedText}" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RailGpuTempText" Grid.Row="1" Text="N/A" Foreground="#FFF2D6F0" FontSize="12" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="2,0">
                                <Border Background="{DynamicResource CardStroke}" Height="1" VerticalAlignment="Top"/>
                                <Border Width="2" CornerRadius="1" Background="{StaticResource MintAccent}" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                <Grid Margin="8,3,2,3">
                                    <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▤" Grid.RowSpan="2" Foreground="{StaticResource MintAccent}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailMemoryLabel" Grid.Column="1" Text="RAM · GB" Foreground="{StaticResource MintAccent}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailMemoryText" Grid.Row="1" Grid.Column="1" Text="-- / --" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" LineHeight="19" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="USED" Foreground="{StaticResource MutedText}" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailMemoryPercentText" Grid.Row="1" Grid.Column="2" Text="--%" Foreground="#FFD2E7DF" FontSize="12" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="3" Margin="2,0">
                                <Border Background="{DynamicResource CardStroke}" Height="1" VerticalAlignment="Top"/>
                                <Border Width="2" CornerRadius="1" Background="{StaticResource CyanAccent}" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                <Grid Margin="8,3,2,3">
                                    <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="↕" Grid.RowSpan="2" Foreground="{StaticResource CyanAccent}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailNetworkLabel" Grid.Column="1" Text="DOWN" Foreground="{StaticResource MintAccent}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailDownloadText" Grid.Row="1" Grid.Column="1" Text="0 KB/s" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" LineHeight="19" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="UP" Foreground="#FF9DA9FF" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RailUploadText" Grid.Row="1" Grid.Column="2" Text="0 KB/s" Foreground="{StaticResource PrimaryText}" FontSize="12" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="4" Margin="2,0">
                                <Border Background="{DynamicResource CardStroke}" Height="1" VerticalAlignment="Top"/>
                                <Border Width="2" CornerRadius="1" Background="#FFFFC66D" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                <Grid Margin="8,3,2,3">
                                    <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="⌁" Grid.RowSpan="2" Foreground="#FFFFC66D" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailLatencyLabel" Grid.Column="1" Text="PING" Foreground="#FFFFC66D" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RailPingText" Grid.Row="1" Grid.Column="1" Text="-- ms" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" LineHeight="19" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="LOSS" Foreground="{StaticResource SecondaryText}" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RailPacketLossText" Grid.Row="1" Grid.Column="2" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="12" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Thumb x:Name="RailResizeThumb"
                       Width="18"
                       Height="18"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       Background="Transparent"
                       Margin="0,0,4,4"
                       ToolTip="Drag to resize">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M 6,13 L 13,6 M 10,13 L 13,10" Stroke="#71818E9D" StrokeThickness="1.2"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <!-- One-row desktop dock: every metric reads left-to-right in a single low strip. -->
            <Grid x:Name="DockDesign" Visibility="Collapsed">
                <Border x:Name="DockShell"
                        Margin="4"
                        CornerRadius="22"
                        Background="#E012151C"
                        BorderBrush="{DynamicResource CardStroke}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.42" Color="#FF000000"/>
                    </Border.Effect>
                    <Grid ClipToBounds="True" Margin="9,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="DockHeaderDragZone" Background="Transparent" Margin="2,0,5,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DockStatusDot" Width="7" Height="7" Fill="{StaticResource MintAccent}" Margin="0,0,6,0"/>
                                    <TextBlock Text="OPS" Foreground="#FFD8DFE9" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="DockUpdatedText" Text="LIVE" Foreground="{StaticResource MutedText}" FontSize="8.5" FontWeight="SemiBold" Margin="13,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" Margin="0,6">
                            <Border Background="{DynamicResource CardStroke}" Width="1" HorizontalAlignment="Left"/>
                            <Grid Margin="8,0,4,0">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▦" Foreground="{StaticResource CyanAccent}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DockCpuLabel" Grid.Column="1" Text="CPU" Foreground="{StaticResource CyanAccent}" FontSize="9.5" FontWeight="SemiBold"/>
                                    <StackPanel x:Name="DockCpuTempPanel" Grid.Column="2">
                                        <TextBlock x:Name="DockCpuTempText" Text="N/A" Foreground="#FFDCE5EF" FontSize="9.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DockCpuValueText" Grid.Row="1" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DockCpuBar" Grid.Row="2" Minimum="0" Maximum="100" Foreground="{StaticResource CyanAccent}"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="2" Margin="0,6">
                            <Border Background="{DynamicResource CardStroke}" Width="1" HorizontalAlignment="Left"/>
                            <Grid Margin="8,0,4,0">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▣" Foreground="{StaticResource MagentaAccent}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DockGpuLabel" Grid.Column="1" Text="GPU" Foreground="{StaticResource MagentaAccent}" FontSize="9.5" FontWeight="SemiBold"/>
                                    <StackPanel x:Name="DockGpuTempPanel" Grid.Column="2">
                                        <TextBlock x:Name="DockGpuTempText" Text="N/A" Foreground="#FFF2DAEF" FontSize="9.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DockGpuValueText" Grid.Row="1" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DockGpuBar" Grid.Row="2" Minimum="0" Maximum="100" Foreground="{StaticResource MagentaAccent}"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="3" Margin="0,6">
                            <Border Background="{DynamicResource CardStroke}" Width="1" HorizontalAlignment="Left"/>
                            <Grid Margin="8,0,5,0">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="▤" Foreground="{StaticResource MintAccent}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DockMemoryLabel" Grid.Column="1" Text="RAM · GB" Foreground="{StaticResource MintAccent}" FontSize="9.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DockMemoryPercentText" Grid.Column="2" Text="--%" Foreground="{StaticResource SecondaryText}" FontSize="9"/>
                                </Grid>
                                <TextBlock x:Name="DockMemoryText" Grid.Row="1" Text="-- / --" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="DockMemoryBar" Grid.Row="2" Minimum="0" Maximum="100" Foreground="{StaticResource MintAccent}"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="4" Margin="0,6">
                            <Border Background="{DynamicResource CardStroke}" Width="1" HorizontalAlignment="Left"/>
                            <Grid Margin="8,0,4,0">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="↕" Foreground="{StaticResource CyanAccent}" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="DockNetworkLabel" Text="NET" Foreground="{StaticResource CyanAccent}" FontSize="9.5" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DOWN" Foreground="{StaticResource MintAccent}" FontSize="8.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DockDownloadText" Text="0K/s" Foreground="{StaticResource PrimaryText}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="UP" Foreground="#FF9DA9FF" FontSize="8.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DockUploadText" Text="0K/s" Foreground="{StaticResource PrimaryText}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2" Height="1" Background="{DynamicResource CardStroke}"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="5" Margin="0,6">
                            <Border Background="{DynamicResource CardStroke}" Width="1" HorizontalAlignment="Left"/>
                            <Grid Margin="8,0,4,0">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DockLatencyLabel" Text="PING" Foreground="#FFFFC66D" FontSize="8.5" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="LOSS" Foreground="{StaticResource SecondaryText}" FontSize="8.5" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DockPingText" Text="--ms" Foreground="{StaticResource PrimaryText}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DockPacketLossText" Grid.Column="1" Text="--%" Foreground="{StaticResource PrimaryText}" FontSize="13.5" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Grid.Row="2" Height="1" Background="{DynamicResource CardStroke}"/>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock x:Name="DockLockBadge" Text="●" Foreground="#FFFFC66D" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"/>
                            <Button x:Name="DockSettingsButton"
                                    Style="{StaticResource IconButton}"
                                    Width="26"
                                    Height="26"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Content="&#xE713;"
                                    ToolTip="Settings"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Thumb x:Name="DockResizeThumb"
                       Width="17"
                       Height="17"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       Background="Transparent"
                       Margin="0,0,4,4"
                       ToolTip="Drag to resize">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M 6,12 L 12,6 M 9,12 L 12,9" Stroke="#71818E9D" StrokeThickness="1.1"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
