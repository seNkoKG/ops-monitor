                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Export &amp; privacy" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,10,0,4" Text="Format" Style="{StaticResource EyebrowText}"/>
