<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpsMonitor.Core\OpsMonitor.Core.csproj" />
    <EmbeddedResource Include="Assets\Weather\*.svg" />
    <EmbeddedResource Include="Assets\Weather\Meteocons-LICENSE.txt" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\OpsMonitor.ico</ApplicationIcon>
    <AssemblyName>OpsMonitor.Widget</AssemblyName>
    <RootNamespace>OpsMonitor.Widget</RootNamespace>
  </PropertyGroup>

</Project>
