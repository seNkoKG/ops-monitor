                            <controls:StudioSettingField Margin="8,0,8,12" Header="Latency" Description="Ping and loss" Text="{Binding LatencyAccent}" ShowSwatch="True" SwatchBrush="{Binding LatencyAccentBrush}"/>
                            <controls:StudioSettingField Margin="8,0,0,12" Header="Weather" Description="Forecast" Text="{Binding WeatherAccent}" ShowSwatch="True" SwatchBrush="{Binding WeatherAccentBrush}"/>
                            <controls:StudioSettingField Margin="0,0,8,0" Header="Warning" Description="Caution" Text="{Binding Warning}" ShowSwatch="True" SwatchBrush="{Binding WarningBrush}"/>
                            <controls:StudioSettingField Margin="8,0,8,0" Header="Critical" Description="Danger" Text="{Binding Critical}" ShowSwatch="True" SwatchBrush="{Binding CriticalBrush}"/>
                            <controls:StudioSettingField Margin="8,0,0,0" Header="Success" Description="Healthy" Text="{Binding Success}" ShowSwatch="True" SwatchBrush="{Binding SuccessBrush}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Geometry">
