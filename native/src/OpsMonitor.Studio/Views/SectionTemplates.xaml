                            <Border Margin="0,16,0,0" Padding="12" Background="#1463E6A6" BorderBrush="#4463E6A6" BorderThickness="1" CornerRadius="10">
                                <TextBlock Text="History stays local. Public IPs and process names are excluded unless explicitly enabled." Style="{StaticResource CaptionText}" Foreground="{StaticResource Brush.Success}" TextWrapping="Wrap" TextTrimming="None"/>
                            </Border>
