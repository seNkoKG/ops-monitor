<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:OpsMonitor.Studio.Controls"
                    xmlns:models="clr-namespace:OpsMonitor.Studio.Models">

    <Style x:Key="PageStack" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,8,30"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
        <Setter Property="Margin" Value="2,0,0,9"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    </Style>

    <Style x:Key="SettingRow" TargetType="Border">
        <Setter Property="Padding" Value="0,12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="MiniMetric" TargetType="Border" BasedOn="{StaticResource InsetBorder}">
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="MinHeight" Value="92"/>
    </Style>

    <Style x:Key="SmallProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface3}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="DesignerTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource Brush.Surface2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="#1848DCF9"/>
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="#4D48DCF9"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesignerTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DesignerTabItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Margin="0,0,0,16" Padding="5" HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" CornerRadius="12">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SceneCardTemplate" DataType="{x:Type models:SceneItem}">
        <Border Width="210" Margin="0,0,10,10" Padding="14" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="11">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                    <Border HorizontalAlignment="Right" Padding="7,3" Background="{StaticResource Brush.Surface3}" CornerRadius="6">
                        <TextBlock Text="{Binding Layout}" FontFamily="{StaticResource Font.Mono}" FontSize="9" Foreground="{Binding Accent}"/>
                    </Border>
                </Grid>
                <TextBlock Margin="0,7,0,12" MinHeight="32" Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
                <Button Content="Activate scene"
                        Command="{Binding DataContext.ActivateSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource StudioButton}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Page.Overview">
        <ScrollViewer>
            <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="RUNTIME" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}" BorderBrush="#5548DCF9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Success}" Margin="0,4,8,0"/>
                                <TextBlock Text="WIDGET CONNECTED" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Success}"/>
                            </StackPanel>
                            <TextBlock Margin="0,13,0,0" Text="Your desktop instrument is live." FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,30,0" Text="Settings are synchronized locally. Changes apply without restarting telemetry providers." Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                            <StackPanel Margin="0,17,0,0" Orientation="Horizontal">
                                <Button Content="Open visual designer" Command="{Binding NavigateCommand}" CommandParameter="appearance" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Configure data sources" Command="{Binding NavigateCommand}" CommandParameter="providers" Style="{StaticResource StudioButton}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" MinWidth="150" Padding="16" Background="#1848DCF9" BorderBrush="#3D48DCF9" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SCENE" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding ActiveScene, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedLayout}" Foreground="{StaticResource Brush.Accent}" FontFamily="{StaticResource Font.Mono}" FontSize="11"/>
                                <TextBlock Margin="0,14,0,0" Text="LIVE APPLY" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Brush.Success}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="RESOURCE IMPACT" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MiniMetric}">
                        <StackPanel><TextBlock Text="CPU" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,8,0,3" Text="{Binding ResourceCpu}" FontFamily="{StaticResource Font.Display}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Studio and widget" Style="{StaticResource CaptionText}"/><ProgressBar Margin="0,9,0,0" Style="{StaticResource SmallProgress}" Value="{Binding ResourceCpuPercent, Mode=OneWay}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MiniMetric}">
                        <StackPanel><TextBlock Text="MEMORY" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,8,0,3" Text="{Binding ResourceMemory}" FontFamily="{StaticResource Font.Display}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Combined working set" Style="{StaticResource CaptionText}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MiniMetric}" Margin="0">
                        <StackPanel><TextBlock Text="POLLING POLICY" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,8,0,3" Text="{Binding ResourceWakeups}" FontFamily="{StaticResource Font.Display}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding PerformanceMode}" Style="{StaticResource CaptionText}"/></StackPanel>
                    </Border>
                </Grid>

                <TextBlock Margin="2,22,0,9" Text="SCENES" Style="{StaticResource SectionLabel}"/>
                <ItemsControl ItemsSource="{Binding Scenes}" ItemTemplate="{StaticResource SceneCardTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Widgets">
        <ScrollViewer>
            <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="FORM FACTOR" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Choose the widget silhouette" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,5,0,15" Text="Each layout has independent readability clamps. The canvas shows the exact selected form." Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Layouts}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,0" Padding="13" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" Style="{StaticResource StudioButton}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Icon}" FontSize="21" Foreground="{StaticResource Brush.Accent}"/>
                                            <TextBlock Margin="0,7,0,0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="MODULE STACK" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Order and visibility" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,14" Text="Select a module to edit it. Toggle visibility or change its order without losing settings." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" ItemContainerStyle="{StaticResource CompactListItem}" MaxHeight="560">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="27" Height="27" Background="#16212E3D" CornerRadius="7"><TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Margin="0,2,0,0" Text="{Binding Category}" Style="{StaticResource CaptionText}"/></StackPanel>
                                            <CheckBox Grid.Column="2" Margin="0,0,7,0" IsChecked="{Binding IsVisible}" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{Binding Name, StringFormat=Show {0}}"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Content="↑" Command="{Binding DataContext.MoveModuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="0,0,4,0" ToolTip="Move up"/>
                                                <Button Content="↓" Command="{Binding DataContext.MoveModuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" ToolTip="Move down"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" DataContext="{Binding SelectedModule}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Module inspector" Style="{StaticResource SectionTitleText}"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding OverrideSummary}" Foreground="{Binding Accent}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Button Content="Reset visual overrides"
                                            Command="{Binding DataContext.ResetModuleOverridesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource StudioButton}"/>
                                    <TextBlock Margin="0,5,0,0" Text="{Binding Source}" MaxWidth="180" TextAlignment="Right" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <controls:StudioSettingField Margin="0,0,8,12" Header="Display title" Description="24 chars" MaxLength="24" Text="{Binding CustomTitle}"/>
                                <controls:StudioSettingField Margin="8,0,0,12" Header="Icon or glyph" Description="8 chars" MaxLength="8" Text="{Binding CustomIcon}"/>
                                <controls:StudioSettingField Margin="0,0,8,12" Header="Accent color" Description="ARGB hex" Text="{Binding AccentHex}" ShowSwatch="True" SwatchBrush="{Binding Accent}"/>
                                <StackPanel Margin="8,0,0,12"><TextBlock Text="Visualization" FontWeight="SemiBold"/><ComboBox Margin="0,7,0,0" ItemsSource="{Binding DataContext.Visualizations, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Visualization}" AutomationProperties.Name="Visualization"/></StackPanel>
                                <StackPanel Margin="0,0,8,12"><TextBlock Text="Number precision" FontWeight="SemiBold"/><ComboBox Margin="0,7,0,0" ItemsSource="{Binding DataContext.PrecisionOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Precision}" AutomationProperties.Name="Number precision"/></StackPanel>
                                <StackPanel Margin="8,0,0,12"><TextBlock Text="Card size" FontWeight="SemiBold"/><ComboBox Margin="0,7,0,0" ItemsSource="{Binding DataContext.ModuleSizes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Size}" AutomationProperties.Name="Card size"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <controls:StudioSettingToggle Margin="0,0,6,7" Header="Custom accent" Description="Override semantic color" IsChecked="{Binding UseCustomAccent}"/>
                                <controls:StudioSettingToggle Margin="6,0,0,7" Header="Module label" Description="Show title" IsChecked="{Binding ShowLabel}"/>
                                <controls:StudioSettingToggle Margin="0,0,6,7" Header="Icon" Description="Show module glyph" IsChecked="{Binding ShowIcon}"/>
                                <controls:StudioSettingToggle Margin="6,0,0,7" Header="Accent rail" Description="Colored edge" IsChecked="{Binding ShowAccent}"/>
                                <controls:StudioSettingToggle Margin="0,0,6,7" Header="Trend" Description="Sparkline when supported" IsChecked="{Binding ShowSparkline}"/>
                                <controls:StudioSettingToggle Margin="6,0,0,7" Header="Secondary reading" Description="Temperature or quality" IsChecked="{Binding ShowTemperature}"/>
                            </UniformGrid>
                            <Border Margin="0,7,0,0" Padding="14,12" Background="#1417BFD8" BorderBrush="#5548DCF9" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:StudioSettingSlider Grid.Column="0" Margin="0,0,10,0" Header="Temperature / status size" Description="CPU and GPU temperature, packet loss and metadata" Minimum="-1" Maximum="24" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" InheritAtMinimum="True" Value="{Binding SecondarySize}"/>
                                    <controls:StudioSettingSlider Grid.Column="1" Margin="10,0,0,0" Header="Primary value size" Description="Load, memory, network and latency values" Minimum="-1" Maximum="42" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" InheritAtMinimum="True" Value="{Binding ValueSize}"/>
                                </Grid>
                            </Border>
                            <Expander Margin="0,12,0,0" Header="Advanced module overrides" IsExpanded="False">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,12" Text="INHERIT follows the global design system. Overrides affect only this module and remain safe in Mini and Pill." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,0,0,9" Text="COLOR IDENTITY" Style="{StaticResource SectionLabel}"/>
                                    <UniformGrid Columns="2">
                                        <controls:StudioSettingToggle Margin="0,0,6,7" Header="Custom card" Description="Own surface color" IsChecked="{Binding UseCustomCardColor}"/>
                                        <controls:StudioSettingField Margin="6,0,0,7" Header="Card color" Description="ARGB" Text="{Binding CardHex}" IsEnabled="{Binding UseCustomCardColor}" ShowSwatch="True" SwatchBrush="{Binding CardSwatch}"/>
                                        <controls:StudioSettingToggle Margin="0,0,6,7" Header="Custom border" Description="Own outline color" IsChecked="{Binding UseCustomBorderColor}"/>
                                        <controls:StudioSettingField Margin="6,0,0,7" Header="Border color" Description="ARGB" Text="{Binding BorderHex}" IsEnabled="{Binding UseCustomBorderColor}" ShowSwatch="True" SwatchBrush="{Binding BorderSwatch}"/>
                                        <controls:StudioSettingToggle Margin="0,0,6,7" Header="Custom primary text" Description="Metric value color" IsChecked="{Binding UseCustomPrimaryTextColor}"/>
                                        <controls:StudioSettingField Margin="6,0,0,7" Header="Primary text" Description="ARGB" Text="{Binding PrimaryTextHex}" IsEnabled="{Binding UseCustomPrimaryTextColor}" ShowSwatch="True" SwatchBrush="{Binding PrimaryTextSwatch}"/>
                                        <controls:StudioSettingToggle Margin="0,0,6,7" Header="Custom secondary text" Description="Status and metadata" IsChecked="{Binding UseCustomSecondaryTextColor}"/>
                                        <controls:StudioSettingField Margin="6,0,0,7" Header="Secondary text" Description="ARGB" Text="{Binding SecondaryTextHex}" IsEnabled="{Binding UseCustomSecondaryTextColor}" ShowSwatch="True" SwatchBrush="{Binding SecondaryTextSwatch}"/>
                                        <controls:StudioSettingToggle Margin="0,0,6,7" Header="Custom track" Description="Graph and bar base" IsChecked="{Binding UseCustomTrackColor}"/>
                                        <controls:StudioSettingField Margin="6,0,0,7" Header="Track color" Description="ARGB" Text="{Binding TrackHex}" IsEnabled="{Binding UseCustomTrackColor}" ShowSwatch="True" SwatchBrush="{Binding TrackSwatch}"/>
                                    </UniformGrid>

                                    <TextBlock Margin="0,16,0,9" Text="SURFACE AND GRAPH" Style="{StaticResource SectionLabel}"/>
                                    <controls:StudioSettingSlider Header="Card opacity" Description="Module surface only" Minimum="0.2" Maximum="1" SmallChange="0.02" ValueFormat="0%" Value="{Binding CardOpacity}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Border opacity" Description="Module outline only" Minimum="0" Maximum="1" SmallChange="0.02" ValueFormat="0%" Value="{Binding BorderOpacity}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Card radius" Description="Override global corner radius" Minimum="-1" Maximum="40" SmallChange="1" Unit=" px" InheritAtMinimum="True" Value="{Binding CardCornerRadius}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Border width" Description="Override global card outline" Minimum="-1" Maximum="4" SmallChange="0.25" ValueFormat="0.00" Unit=" px" InheritAtMinimum="True" Value="{Binding CardBorderWidth}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Card gap" Description="Space after this module" Minimum="-1" Maximum="20" SmallChange="1" Unit=" px" InheritAtMinimum="True" Value="{Binding CardGap}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Card padding" Description="Override global inner spacing" Minimum="-1" Maximum="28" SmallChange="1" Unit=" px" InheritAtMinimum="True" Value="{Binding CardPadding}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Accent width" Description="Override colored rail thickness" Minimum="-1" Maximum="10" SmallChange="0.5" ValueFormat="0.0" Unit=" px" InheritAtMinimum="True" Value="{Binding AccentWidth}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Progress height" Description="Override progress or graph height" Minimum="-1" Maximum="12" SmallChange="0.5" ValueFormat="0.0" Unit=" px" InheritAtMinimum="True" Value="{Binding ProgressHeight}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Progress radius" Description="Bar corner curve" Minimum="-1" Maximum="6" SmallChange="0.5" ValueFormat="0.0" Unit=" px" InheritAtMinimum="True" Value="{Binding ProgressCornerRadius}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Sparkline stroke" Description="Trend line thickness" Minimum="-1" Maximum="5" SmallChange="0.25" ValueFormat="0.00" Unit=" px" InheritAtMinimum="True" Value="{Binding SparklineThickness}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Sparkline fill" Description="Area tint below the line" Minimum="-1" Maximum="0.5" SmallChange="0.02" ValueFormat="0%" InheritAtMinimum="True" Value="{Binding SparklineFillOpacity}"/>

                                    <TextBlock Margin="0,16,0,9" Text="TYPE OVERRIDES" Style="{StaticResource SectionLabel}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Label size" Description="Override module label type" Minimum="-1" Maximum="26" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" InheritAtMinimum="True" Value="{Binding LabelSize}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Temperature / status size" Description="Override temperature, loss and metadata" Minimum="-1" Maximum="24" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" InheritAtMinimum="True" Value="{Binding SecondarySize}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Value size" Description="Override primary value type" Minimum="-1" Maximum="42" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" InheritAtMinimum="True" Value="{Binding ValueSize}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Icon size" Description="Override the module glyph" Minimum="-1" Maximum="32" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" InheritAtMinimum="True" Value="{Binding IconSize}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Label weight" Description="100 thin to 900 black" Minimum="-1" Maximum="900" SmallChange="50" TickFrequency="50" ValueFormat="0" InheritAtMinimum="True" Value="{Binding LabelWeight}"/>
                                    <controls:StudioSettingSlider Margin="0,10,0,0" Header="Value weight" Description="Primary value emphasis" Minimum="-1" Maximum="900" SmallChange="50" TickFrequency="50" ValueFormat="0" InheritAtMinimum="True" Value="{Binding ValueWeight}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Appearance">
        <TabControl Style="{StaticResource DesignerTabControl}">
            <TabItem Header="Presets">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="DESIGN SYSTEM" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}" BorderBrush="#5548DCF9">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Start from a complete visual system" Style="{StaticResource SectionTitleText}"/><TextBlock Margin="0,5,20,14" Text="Presets change every linked token. Fine-tune below, then export a portable design file." Style="{StaticResource BodyText}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Import .opsdesign" Command="{Binding ImportDesignCommand}" Style="{StaticResource StudioButton}" Margin="0,0,8,0"/><Button Content="Export design" Command="{Binding ExportDesignCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="158" Margin="0,0,8,8" Padding="0" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource StudioButton}">
                                        <Border Padding="12" Background="{Binding SurfaceBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" Margin="0,2,7,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding PreviewTextBrush}"/></StackPanel><TextBlock Margin="0,7,0,0" MinHeight="32" Text="{Binding Description}" FontSize="10" Foreground="{Binding PreviewSecondaryTextBrush}" TextWrapping="Wrap" TextTrimming="None"/></StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="COMPOSITION" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Transparency" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,15" Text="Shell and content opacity are independent, so text can remain readable over a light desktop." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <controls:StudioSettingSlider Header="Shell opacity" Description="Outer widget surface" Minimum="0.08" Maximum="1" SmallChange="0.02" ValueFormat="0%" Value="{Binding BackgroundOpacity}"/>
