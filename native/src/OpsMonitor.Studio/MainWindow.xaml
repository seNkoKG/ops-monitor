<Window x:Class="OpsMonitor.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OpsMonitor.Studio.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="OPS Monitor Studio"
        Width="1560"
        Height="940"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Loaded="OnLoaded"
        Closing="OnClosing"
        SizeChanged="OnWindowSizeChanged"
        KeyDown="OnWindowKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="#F805070B"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F20A0D13"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="#1F48DCF9" BorderBrush="#6648DCF9" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Path Width="17" Height="17" Stretch="Uniform" Fill="{StaticResource Brush.Accent}"
                                      Data="M2,2 L6,2 L6,6 L2,6 Z M8,2 L12,2 L12,6 L8,6 Z M2,8 L6,8 L6,12 L2,12 Z M8,8 L12,8 L12,12 L8,12 Z"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="OPS MONITOR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="CONTROL STUDIO  /  3.2" FontFamily="{StaticResource Font.Mono}" FontSize="9" Foreground="{StaticResource Brush.Accent}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Margin="10,0" Text="/" Foreground="{StaticResource Brush.BorderStrong}"/>
                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="250" Height="36" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="33,7,48,7"
                                     AutomationProperties.Name="Filter workspace sections"
                                     ToolTip="Filter workspace sections (Ctrl+K)"
                                     Style="{StaticResource StudioTextBox}"/>
                            <TextBlock Margin="12,0,0,0" Text="⌕" FontSize="16" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Margin="32,0,45,0" Text="Filter sections" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Margin="0,0,8,0" Padding="6,2" Background="{StaticResource Brush.Surface3}" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="CTRL K" FontFamily="{StaticResource Font.Mono}" FontSize="9" Foreground="{StaticResource Brush.TextMuted}"/>
                            </Border>
                        </Grid>
                        <Button Content="↶" Command="{Binding UndoCommand}" Style="{StaticResource IconButton}" Margin="0,0,6,0" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"/>
                        <Button Content="↷" Command="{Binding RedoCommand}" Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource ChromeButton}" Click="OnMinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource ChromeButton}" Click="OnMaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
                        <Button Content="×" Style="{StaticResource CloseChromeButton}" Click="OnCloseClick" ToolTip="Close" AutomationProperties.Name="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="430"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F20A0D13" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Margin="14,16,14,16" Padding="13,11" Background="#1248DCF9" BorderBrush="#3548DCF9" BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ACTIVE WIDGET" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Margin="0,5,0,0" Text="{Binding ActiveScene, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}"><Run Text="{Binding SelectedLayout}"/><Run Text="  ·  Synced"/></TextBlock>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="28" Height="28" VerticalAlignment="Top">
                                    <Ellipse Fill="#2558E6B2"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Margin="22,0,0,7" Text="CONFIGURE" Style="{StaticResource EyebrowText}"/>
                        <ListBox Grid.Row="2"
                                 Margin="5,0"
                                 ItemsSource="{Binding NavigationView}"
                                 SelectedItem="{Binding SelectedNavigation}"
                                 ItemContainerStyle="{StaticResource NavigationItem}"
                                 SelectionChanged="OnNavigationSelectionChanged"
                                 AutomationProperties.Name="Studio sections">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="25" Height="25" Background="#101B2635" CornerRadius="7" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            <TextBlock Margin="0,2,0,0" Text="{Binding Description}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Margin="14,12,14,16">
                            <Button Content="{Binding WidgetActionLabel}" Command="{Binding OpenOrRestartWidgetCommand}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center"/>
                            <Grid Margin="3,12,3,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Success}" Margin="0,0,7,0"/>
                                    <TextBlock Text="LIVE APPLY" FontFamily="{StaticResource Font.Mono}" FontSize="9" Foreground="{StaticResource Brush.Success}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding LastAppliedText}" FontSize="9" Foreground="{StaticResource Brush.TextMuted}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="{StaticResource Brush.Window}">
                                    <GeometryDrawing.Pen><Pen Brush="#102A394E" Thickness="0.5"/></GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="32,0"/><LineGeometry StartPoint="0,0" EndPoint="0,32"/></GeometryGroup></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Border Background="#D9080B11" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="26,0,22,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentPageTitle}" FontFamily="{StaticResource Font.Display}" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding CurrentPageDescription}" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Margin="0,0,8,0" Padding="9,6" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10"><Run Text="SCENE  " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding ActiveScene, Mode=OneWay}" Foreground="{StaticResource Brush.Accent}"/></TextBlock>
                                </Border>
                                <Button Content="Save to disk" Command="{Binding SaveCommand}" Style="{StaticResource StudioButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost"
                                    Grid.Row="1"
                                    Margin="26,22,18,0"
                                    Content="{Binding}"
                                    ClipToBounds="True"
                                    RenderTransformOrigin="0.5,0">
                        <ContentControl.RenderTransform><TranslateTransform x:Name="PageTranslate"/></ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>

                <Border Grid.Column="2" Background="#F2070A0F" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                    <controls:LiveWidgetPreview/>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#FF080B10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Success}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="9" Foreground="{StaticResource Brush.TextMuted}"
                               Text="CTRL+K  SEARCH    CTRL+Z  UNDO    CTRL+S  SAVE"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
