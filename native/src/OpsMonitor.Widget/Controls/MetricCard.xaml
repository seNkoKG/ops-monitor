<UserControl x:Class="OpsMonitor.Widget.Controls.MetricCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpsMonitor.Widget.Controls"
             xmlns:models="clr-namespace:OpsMonitor.Widget.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="{Binding Title}"
             AutomationProperties.HelpText="{Binding Status}"
             ToolTip="{Binding Status}"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
             Opacity="{Binding VisualOpacity}">
    <UserControl.Resources>
        <Style x:Key="MetricProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background"
                    Value="{Binding DataContext.TrackBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
            <Setter Property="Foreground" Value="{Binding AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Track" CornerRadius="2">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="DetailItemsPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type controls:MetricCard}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="158" />
            <Setter Property="MinHeight" Value="44" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static models:WidgetLayout.Dock}">
                    <Setter Property="Width" Value="180" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Layout, ElementName=Root}"
                                   Value="{x:Static models:WidgetLayout.Dock}" />
                        <Condition Binding="{Binding Density, ElementName=Root}"
                                   Value="{x:Static models:WidgetDensity.Compact}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Width" Value="160" />
                    <Setter Property="MinHeight" Value="64" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Normal}">
                    <Setter Property="MinHeight" Value="104" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Detail}">
                    <Setter Property="MinHeight" Value="144" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <Border Margin="0,0,0,3"
                Padding="7,2"
                Background="{Binding DataContext.CardBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                BorderBrush="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Layout, ElementName=Root}"
                                           Value="{x:Static models:WidgetLayout.Rail}" />
                                <Condition Binding="{Binding Density, ElementName=Root}"
                                           Value="{x:Static models:WidgetDensity.Compact}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Opacity="{Binding ContentOpacity, ElementName=Root}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{Binding AccentBrush}"
                        CornerRadius="2" />

                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="19" />
                        <RowDefinition Height="2" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="16"
                                Height="16"
                                HorizontalAlignment="Left"
                                Background="{Binding DataContext.TrackBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CornerRadius="5">
                            <Path Width="11"
                                  Height="11"
                                  Data="{Binding IconData}"
                                  Stretch="Uniform"
                                  Stroke="{Binding AccentBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.6" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding AccentBrush}"
                                   Text="{Binding Title}" />

                        <StackPanel Grid.Column="2"
                                    Margin="5,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,5,0"
                                     Fill="{Binding StateBrush}" />
                            <TextBlock MaxWidth="92"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       Text="{Binding Status}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Text="{Binding PrimaryValue}"
                               TextTrimming="CharacterEllipsis" />

                    <ProgressBar Grid.Row="2"
                                 Height="2"
                                 Value="{Binding Progress}"
                                 Style="{StaticResource MetricProgressStyle}" />
                </Grid>
            </Grid>
        </Border>

    <Border x:Name="CardSurface"
            Background="{Binding DataContext.CardBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            BorderBrush="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            BorderThickness="1">
        <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="12,11" />
                <Setter Property="CornerRadius" Value="16" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Layout, ElementName=Root}"
                                           Value="{x:Static models:WidgetLayout.Rail}" />
                                <Condition Binding="{Binding Density, ElementName=Root}"
                                           Value="{x:Static models:WidgetDensity.Compact}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static models:WidgetLayout.Rail}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="CornerRadius" Value="11" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static models:WidgetLayout.Dock}">
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="CornerRadius" Value="15" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Compact}">
                        <Setter Property="Padding" Value="9,4" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Layout, ElementName=Root}"
                                       Value="{x:Static models:WidgetLayout.Pill}" />
                            <Condition Binding="{Binding Density, ElementName=Root}"
                                       Value="{x:Static models:WidgetDensity.Compact}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Opacity="{Binding ContentOpacity, ElementName=Root}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,1,0,1"
                    Background="{Binding AccentBrush}"
                    CornerRadius="2" />

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            Margin="0,0,8,0"
                            Background="{Binding DataContext.TrackBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CornerRadius="7">
                        <Path Width="15"
                              Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding IconData}"
                              Stretch="Uniform"
                              Stroke="{Binding AccentBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.6" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"
                               Text="{Binding Title}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 Fill="{Binding StateBrush}" />
                        <TextBlock MaxWidth="104"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Text="{Binding Status}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Text="{Binding PrimaryValue}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="Margin" Value="0,6,0,5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Compact}">
                                    <Setter Property="FontSize" Value="20" />
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static models:WidgetLayout.Dock}">
                                    <Setter Property="FontSize" Value="21" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Layout, ElementName=Root}" Value="{x:Static models:WidgetLayout.Rail}">
                                    <Setter Property="FontSize" Value="22" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ProgressBar Value="{Binding Progress}" Style="{StaticResource MetricProgressStyle}" />

                <ItemsControl x:Name="DetailPanel"
                              Margin="0,9,0,0"
                              ItemsPanel="{StaticResource DetailItemsPanel}"
                              ItemsSource="{Binding Details}">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Compact}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,6">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Density, RelativeSource={RelativeSource AncestorType={x:Type controls:MetricCard}}}"
                                                               Value="{x:Static models:WidgetDensity.Normal}" />
                                                    <Condition Binding="{Binding IsNormalVisible}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="12"
                                               Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Text="{Binding Label}" />
                                    <TextBlock Margin="0,1,0,0"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Text="{Binding Value}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="ChartHost"
                      Height="28"
                      Margin="0,4,0,0"
                      ClipToBounds="True">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Height" Value="28" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Compact}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Density, ElementName=Root}" Value="{x:Static models:WidgetDensity.Detail}">
                                    <Setter Property="Height" Value="36" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Path Data="{Binding HistoryAreaGeometry}"
                          Fill="{Binding HistoryFillBrush}"
                          Stretch="Fill" />
                    <Path Data="{Binding HistoryGeometry}"
                          Stretch="Fill"
                          Stroke="{Binding AccentBrush}"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.5" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</UserControl>
