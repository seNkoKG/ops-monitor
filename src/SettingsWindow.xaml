<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="SettingsWindow"
    Title="Performance Pill settings"
    Width="336"
    Height="686"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF5F7FA"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#FFA5AFBD"/>
        <SolidColorBrush x:Key="MutedText" Color="#FF6E7989"/>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7D8A9C"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30778AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Background="#FF343C49" CornerRadius="12" BorderBrush="#25FFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="#FFADB5C0" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF6679F7"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF8492FA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#FF778AFF"/>
        </Style>
    </Window.Resources>

    <Border Margin="7"
            CornerRadius="24"
            Background="#F0191D26"
            BorderBrush="#35FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.5" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsDragZone" Margin="20,8,13,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pill settings" Foreground="{StaticResource PrimaryText}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Tune the widget without cluttering it." Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="SettingsCloseButton"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButton}"
                        Width="34"
                        Height="34"
                        Padding="0"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE711;"
                        ToolTip="Close settings"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,13,0">
                <StackPanel>
                    <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,4,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Always on top" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Keep the Pill above other windows" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <CheckBox x:Name="AlwaysTopCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,4,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lock position" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Prevent moving and resizing" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <CheckBox x:Name="LockCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,4,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Draggable" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Allow dragging the header to move" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <CheckBox x:Name="DraggableCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,4,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Launch quietly when you sign in" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,4,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Design" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Switch layouts instantly" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <TextBlock x:Name="DesignValueText" Grid.Column="1" Text="Pill" Foreground="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid Columns="3" Rows="1" Margin="0,0,4,11">
                        <Button x:Name="PillDesignButton" Content="Pill" Style="{StaticResource SubtleButton}" Margin="0,0,5,0" ToolTip="Stacked glass cards"/>
                        <Button x:Name="RailDesignButton" Content="Rail" Style="{StaticResource SubtleButton}" Margin="0,0,5,0" ToolTip="Ultra-narrow continuous rail"/>
                        <Button x:Name="DockDesignButton" Content="Dock" Style="{StaticResource SubtleButton}" ToolTip="All metrics in one horizontal row"/>
                    </UniformGrid>
                    <Grid Margin="0,0,4,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Background opacity" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="88%" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="88" TickFrequency="1" Margin="0,0,4,8"/>
                    <Grid Margin="0,3,4,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Scale" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                        <TextBlock x:Name="ScaleValueText" Grid.Column="1" Text="100%" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    </Grid>
                    <Slider x:Name="ScaleSlider" Minimum="80" Maximum="150" Value="100" TickFrequency="5" IsSnapToTickEnabled="False" Margin="0,0,4,9"/>
                    <UniformGrid Columns="2" Rows="2" Margin="0,0,4,3">
                        <Button x:Name="MiniButton" Content="Mini · 80%" Style="{StaticResource SubtleButton}" Margin="0,0,5,5"/>
                        <Button x:Name="SlimButton" Content="Slim · 90%" Style="{StaticResource SubtleButton}" Margin="0,0,0,5"/>
                        <Button x:Name="BalancedButton" Content="Balanced · 100%" Style="{StaticResource SubtleButton}" Margin="0,0,5,0"/>
                        <Button x:Name="ComfortButton" Content="Comfort · 115%" Style="{StaticResource SubtleButton}"/>
                    </UniformGrid>

                    <TextBlock Text="DISPLAY" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,4,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Temperature readings" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Show CPU and GPU temperature" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowTemperaturesCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Background="#0EFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,4,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CPU sensor access" Foreground="{StaticResource PrimaryText}" FontSize="12"/>
                                <TextBlock x:Name="CpuSensorStatusText" Text="Checking sensor…" Foreground="{StaticResource MutedText}" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="EnableCpuSensorButton"
                                    Grid.Column="1"
                                    Content="Enable"
                                    Style="{StaticResource SubtleButton}"
                                    Padding="10,5"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,4,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Metric labels" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Hide section labels for a quieter look" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowLabelsCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,4,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Refresh rate" Foreground="{StaticResource PrimaryText}" FontSize="13"/>
                            <TextBlock Text="Slower uses fewer resources" Foreground="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                        <ComboBox x:Name="RefreshCombo"
                                  Grid.Column="1"
                                  Height="31"
                                  Foreground="#FF151922"
                                  Background="#FFDCE2EC"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="1 second" Tag="1"/>
                            <ComboBoxItem Content="2 seconds" Tag="2"/>
                            <ComboBoxItem Content="3 seconds" Tag="3"/>
                            <ComboBoxItem Content="5 seconds" Tag="5"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="20,8,13,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ResetPositionButton" Content="Reset position" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"/>
                <Button x:Name="DoneButton" Grid.Column="1" Content="Done" Style="{StaticResource SubtleButton}" Foreground="White" Background="#FF687AF3" BorderBrush="#FF8391F7" Width="72"/>
            </Grid>
        </Grid>
    </Border>
</Window>
