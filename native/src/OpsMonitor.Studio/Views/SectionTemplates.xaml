                                                <TextBlock Text="{Binding Sensors}" Style="{StaticResource CaptionText}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}">
                                            <Run Text="Response "/>
                                            <Run Text="{Binding Latency, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Content="Test"
                                            Command="{Binding DataContext.TestProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource StudioButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Source priority" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,14" Text="Temperature fallbacks stop at the first valid sensor." Style="{StaticResource CaptionText}"/>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="1  Fresh bridge reading" FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Right" Text="Use" Foreground="{StaticResource Brush.Success}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="2  Optional sensor connector" FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Right" Text="Not connected" Style="{StaticResource CaptionText}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource InsetBorder}">
                                <Grid>
                                    <TextBlock Text="3  Show unavailable" FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Right" Text="Never estimate" Style="{StaticResource CaptionText}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Integrations" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,10" Text="Extensions are isolated, versioned and disabled by default." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Local HTTP endpoint" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,58,0" Text="Read-only metrics on localhost." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsEnabled="False"
                                              ToolTip="The local API is not available in v2.0."
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="OBS overlay bridge" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,58,0" Text="Publish a selected scene." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsEnabled="False"
                                              ToolTip="The OBS bridge is not available in v2.0."
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                            <Button Margin="0,14,0,0"
                                    Content="Open extension manager"
                                    IsEnabled="False"
                                    ToolTip="Extensions are planned for a later release."
                                    Style="{StaticResource StudioButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Accessibility">
        <ScrollViewer>
            <StackPanel Margin="0,0,8,28">
                <Border Style="{StaticResource CardBorder}" BorderBrush="#4462A7FF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Readability first" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,0" Text="The widget stays legible at compact scale and in busy desktop environments." Style="{StaticResource BodyText}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource TagBorder}" Background="#1763E6A6" BorderBrush="#4463E6A6">
                            <TextBlock Text="READABILITY GUARD" Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Vision &amp; type" Style="{StaticResource SectionTitleText}"/>
                            <Border Style="{StaticResource SettingRow}" Margin="0,7,0,0">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Contrast guard" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,0,0" Text="Clamp combinations that weaken text." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ContrastGuard}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Follow Windows text scale" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,0,0" Text="Respect system accessibility settings." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseSystemTextScale}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Redundant color cues" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,0,0" Text="Use icons and labels with alert colors." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RedundantColorCues}"/>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,15,0,4" Text="Studio text scale" Style="{StaticResource EyebrowText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <Slider Minimum="0.9" Maximum="1.35" Value="{Binding FontScale}"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" Text="{Binding FontScale, StringFormat={}{0:P0}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Motion &amp; input" Style="{StaticResource SectionTitleText}"/>
                            <Border Style="{StaticResource SettingRow}" Margin="0,7,0,0">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Reduce motion" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,0,0" Text="Replace transitions with instant state changes." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReducedMotion}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Larger interaction targets" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,0,0" Text="Increase controls to at least 44 × 44 px." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LargeTargets}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel Margin="0,0,60,0">
                                        <TextBlock Text="Keyboard navigation hints" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,3,0,0" Text="Reveal shortcuts while Alt is held." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="False"
                                              IsEnabled="False"
                                              ToolTip="Keyboard hint overlays are not available in v2.0."
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,12,0,0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Widget readability audit" Style="{StaticResource SectionTitleText}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource InsetBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontSize="18"/><TextBlock Margin="0,7,0,0" Text="12 px minimum" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="At 80% compact scale" Style="{StaticResource CaptionText}"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource InsetBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontSize="18"/><TextBlock Margin="0,7,0,0" Text="Text stays opaque" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="Independent surface alpha" Style="{StaticResource CaptionText}"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource InsetBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontSize="18"/><TextBlock Margin="0,7,0,0" Text="Aligned baselines" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="Shared metric grid" Style="{StaticResource CaptionText}"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource InsetBorder}">
                                <StackPanel><TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontSize="18"/><TextBlock Margin="0,7,0,0" Text="Color + symbol" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="Never color alone" Style="{StaticResource CaptionText}"/></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Diagnostics">
        <ScrollViewer>
            <StackPanel Margin="0,0,8,28">
                <Border Style="{StaticResource CardBorder}" BorderBrush="#4463E6A6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Accent}" Margin="0,3,9,0"/>
                                <TextBlock Text="LIVE LOCAL SNAPSHOT" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Brush.Accent}"/>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="Measured, not estimated." Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Text="CPU and working-set figures are sampled from the running Studio and widget. Test each sensor source on Providers &amp; Integrations."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>

                <TextBlock Margin="0,22,0,10" Text="Live resource impact" Style="{StaticResource SectionTitleText}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MiniMetric}">
                        <StackPanel>
                            <TextBlock Text="PROCESSOR" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,7,0,6" Text="{Binding ResourceCpu}" FontSize="22" FontWeight="SemiBold"/>
                            <ProgressBar Style="{StaticResource SmallProgress}"
                                         Maximum="5"
                                         Value="{Binding ResourceCpuPercent, Mode=OneWay}"/>
                            <TextBlock Margin="0,7,0,0" Text="Studio + widget · 5% scale" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MiniMetric}">
                        <StackPanel>
                            <TextBlock Text="WORKING SET" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,7,0,6" Text="{Binding ResourceMemory}" FontSize="22" FontWeight="SemiBold"/>
                            <ProgressBar Style="{StaticResource SmallProgress}"
                                         Maximum="1024"
                                         Value="{Binding ResourceMemoryMegabytes, Mode=OneWay}"
                                         Foreground="{StaticResource Brush.Blue}"/>
                            <TextBlock Margin="0,7,0,0" Text="Studio + widget · 1 GB scale" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MiniMetric}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="WAKEUPS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Margin="0,7,0,6" Text="{Binding ResourceWakeups}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,7,0,0" Text="Independent non-overlapping providers" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Runtime notes" Style="{StaticResource SectionTitleText}"/>
                                <Border HorizontalAlignment="Right" Style="{StaticResource TagBorder}">
                                    <TextBlock Text="LOCAL ONLY" Foreground="{StaticResource Brush.Accent}"/>
                                </Border>
                            </Grid>
                            <Border Margin="0,14,0,0" Padding="12" Background="#BB07090D" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding StatusMessage}"/>
                                    <TextBlock Margin="0,7,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding LastAppliedText}"/>
                                    <TextBlock Margin="0,7,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding WidgetActionLabel}"/>
                                    <TextBlock Margin="0,7,0,0"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="No cloud telemetry · no fabricated sensor values"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Content="Review providers"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="providers"
                                        Style="{StaticResource StudioButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Copy diagnostics"
                                        Command="{Binding CopyDiagnosticsCommand}"
                                        Style="{StaticResource StudioButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Build" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Margin="0,12,0,0" Text="{Binding AppVersion}" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,0" Text=".NET 10 · Windows 11 · x64" Style="{StaticResource CaptionText}"/>
                                <Separator Style="{StaticResource HairlineSeparator}"/>
                                <TextBlock Text="Settings file" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding SettingsPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" TextTrimming="None"/>
                                <TextBlock Margin="0,12,0,0" Text="Shared runtime file" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding RuntimeSettingsPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" TextTrimming="None"/>
                                <TextBlock Margin="0,12,0,0" Text="Widget executable" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding WidgetExecutablePath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" TextTrimming="None"/>
                                <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource StudioButton}" Margin="0,0,7,0"/>
                                    <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource StudioButton}"/>
                                </StackPanel>
                                <Button Margin="0,8,0,0" Content="{Binding WidgetActionLabel}" Command="{Binding OpenOrRestartWidgetCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Demo &amp; recovery" Style="{StaticResource SectionTitleText}"/>
                                <Border Style="{StaticResource SettingRow}" Margin="0,5,0,0">
                                    <Grid>
                                        <TextBlock Text="Deterministic demo metrics" VerticalAlignment="Center"/>
                                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DemoMetrics}"/>
                                    </Grid>
                                </Border>
                                <Button Margin="0,12,0,0" Content="Restore demo defaults" Command="{Binding ResetDemoCommand}" Style="{StaticResource DangerButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
