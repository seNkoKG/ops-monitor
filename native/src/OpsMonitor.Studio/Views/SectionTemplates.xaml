                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Shell padding" Description="Space inside the widget" Minimum="0" Maximum="28" SmallChange="1" Unit=" px" Value="{Binding ContentPadding}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Card padding" Description="Space inside each module" Minimum="0" Maximum="28" SmallChange="1" Unit=" px" Value="{Binding CardPadding}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Card opacity" Description="Module surface alpha" Minimum="0" Maximum="1" SmallChange="0.02" ValueFormat="0%" Value="{Binding CardOpacity}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <controls:StudioSettingSlider Header="Shell border" Description="Outer outline" Minimum="0" Maximum="4" SmallChange="0.25" ValueFormat="0.00" Unit=" px" Value="{Binding BorderWidth}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Card border" Description="Module outline" Minimum="0" Maximum="4" SmallChange="0.25" ValueFormat="0.00" Unit=" px" Value="{Binding CardBorderWidth}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Accent width" Description="Colored module rail" Minimum="0" Maximum="10" SmallChange="0.5" ValueFormat="0.0" Unit=" px" Value="{Binding AccentWidth}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Progress height" Description="Bars and compact graphs" Minimum="1" Maximum="12" SmallChange="0.5" ValueFormat="0.0" Unit=" px" Value="{Binding ProgressHeight}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Progress radius" Description="Bar corner curve" Minimum="0" Maximum="6" SmallChange="0.5" ValueFormat="0.0" Unit=" px" Value="{Binding ProgressCornerRadius}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Sparkline stroke" Description="Trend line thickness" Minimum="0.5" Maximum="5" SmallChange="0.25" ValueFormat="0.00" Unit=" px" Value="{Binding SparklineThickness}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Sparkline fill" Description="Area tint below the line" Minimum="0" Maximum="0.5" SmallChange="0.02" ValueFormat="0%" Value="{Binding SparklineFillOpacity}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Header height" Description="Widget title area" Minimum="18" Maximum="64" SmallChange="1" Unit=" px" Value="{Binding HeaderHeight}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Typography">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="TYPE SYSTEM" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}" DataContext="{Binding Designer}">
                    <StackPanel>
                        <TextBlock Text="Typography" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,5,0,16" Text="The minimum readable size protects compact layouts from becoming illegible." Style="{StaticResource CaptionText}"/>
                        <StackPanel>
                            <Grid><TextBlock Text="Font family" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right" Text="Installed Windows fonts" Style="{StaticResource CaptionText}"/></Grid>
                            <ComboBox Margin="0,7,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                      ItemsSource="{Binding DataContext.InstalledFontFamilies, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                      MaxDropDownHeight="360" AutomationProperties.Name="Font family"/>
                        </StackPanel>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <controls:StudioSettingSlider Header="Header size" Description="Widget title" Minimum="8" Maximum="24" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" Value="{Binding HeaderSize}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Label size" Description="Module names" Minimum="8" Maximum="26" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" Value="{Binding LabelSize}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Temperature / status size" Description="CPU/GPU temperature, packet loss and metadata" Minimum="8" Maximum="24" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" Value="{Binding SecondarySize}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Value size" Description="Primary metric values" Minimum="10" Maximum="42" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" Value="{Binding ValueSize}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Icon size" Description="Module glyphs in spacious layouts" Minimum="8" Maximum="32" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" Value="{Binding IconSize}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Readable minimum" Description="Lower safety bound" Minimum="8" Maximum="18" SmallChange="0.5" ValueFormat="0.0" Unit=" pt" Value="{Binding MinimumReadableSize}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <controls:StudioSettingSlider Header="Header weight" Description="100 thin to 900 black" Minimum="100" Maximum="900" SmallChange="50" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding HeaderWeight}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Label weight" Description="Module name weight" Minimum="100" Maximum="900" SmallChange="50" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding LabelWeight}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Temperature / status weight" Description="Temperature, loss and metadata emphasis" Minimum="100" Maximum="900" SmallChange="50" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding SecondaryWeight}"/>
                                <controls:StudioSettingSlider Margin="0,12,0,0" Header="Value weight" Description="Primary metric weight" Minimum="100" Maximum="900" SmallChange="50" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding ValueWeight}"/>
                                <controls:StudioSettingToggle Margin="0,13,0,0" Header="Tabular numbers" Description="Keep changing values aligned" IsChecked="{Binding UseTabularNumbers}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Effects &amp; motion">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="CHROME AND MOTION" Style="{StaticResource SectionLabel}"/>
                <Grid DataContext="{Binding Designer}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Visible chrome" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,14" Text="Hide nonessential elements without losing drag recovery." Style="{StaticResource CaptionText}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Header" Description="Widget title region" IsChecked="{Binding HeaderVisible}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Update indicator" Description="Pulse when fresh data arrives" IsChecked="{Binding StatusIndicatorVisible}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Settings button" Description="Open Studio from the widget" IsChecked="{Binding SettingsButtonVisible}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Drop shadow" Description="Separate the widget from the desktop" IsChecked="{Binding ShadowEnabled}"/>
                            <controls:StudioSettingSlider Margin="0,5,0,9" Header="Shadow opacity" Description="Outer depth" Minimum="0" Maximum="0.8" SmallChange="0.02" ValueFormat="0%" Value="{Binding ShadowOpacity}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Top glow" Description="Subtle light along the shell" IsChecked="{Binding GlowEnabled}"/>
                            <controls:StudioSettingSlider Margin="0,5,0,0" Header="Glow opacity" Description="Highlight strength" Minimum="0" Maximum="0.5" SmallChange="0.02" ValueFormat="0%" Value="{Binding GlowOpacity}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Motion and accessibility" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Margin="0,5,0,14" Text="Motion is optional and always yields to the Windows accessibility setting." Style="{StaticResource CaptionText}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Widget motion" Description="Allow visual transitions" IsChecked="{Binding MotionEnabled}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,7" Header="Update pulse" Description="Animate the freshness indicator" IsChecked="{Binding PulseStatusIndicator}"/>
                            <controls:StudioSettingToggle Margin="0,0,0,12" Header="Respect reduced motion" Description="Follow the Windows animation preference" IsChecked="{Binding RespectReducedMotion}"/>
                            <controls:StudioSettingSlider Header="Transition duration" Description="Update pulse duration" Minimum="0" Maximum="600" SmallChange="10" Unit=" ms" Value="{Binding TransitionMilliseconds}"/>
                            <Border Margin="0,16,0,0" Padding="13" Background="{Binding CardBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid><StackPanel><TextBlock Text="CONTRAST GUARD" Style="{StaticResource EyebrowText}"/><TextBlock Margin="0,5,90,0" Text="{Binding ContrastSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Repair" Command="{Binding DataContext.FixContrastCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StudioButton}"/></Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DataTemplate>

    <DataTemplate x:Key="Page.Window">
        <ScrollViewer>
            <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="INTERACTION" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Desktop behavior" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,5,0,15" Text="These settings affect only the widget window. Studio remains fully interactive." Style="{StaticResource CaptionText}"/>
                        <UniformGrid Columns="2">
                            <controls:StudioSettingToggle Margin="0,0,6,7" Header="Always on top" Description="Stay above regular windows" IsChecked="{Binding AlwaysOnTop}"/>
                            <controls:StudioSettingToggle Margin="6,0,0,7" Header="Lock position" Description="Prevent accidental movement" IsChecked="{Binding PositionLocked}"/>
                            <controls:StudioSettingToggle Margin="0,0,6,7" Header="Draggable" Description="Allow movement while unlocked" IsChecked="{Binding Draggable}"/>
                            <controls:StudioSettingToggle Margin="6,0,0,7" Header="Resizable" Description="Enable the corner resize hit area" IsChecked="{Binding Resizable}"/>
                            <controls:StudioSettingToggle Margin="0,0,6,0" Header="Click-through" Description="Pass mouse input to apps below" IsChecked="{Binding ClickThrough}"/>
                            <controls:StudioSettingToggle Margin="6,0,0,0" Header="Launch at sign-in" Description="Start for this Windows user" IsChecked="{Binding StartAtSignIn}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="SIZE" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Scale and dimensions" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,5,0,16" Text="Scale changes the complete widget. Manual dimensions are validated against the selected layout." Style="{StaticResource CaptionText}"/>
                        <controls:StudioSettingSlider Header="Widget scale" Description="Readable range across monitors" Minimum="80" Maximum="160" SmallChange="10" TickFrequency="10" IsSnapToTickEnabled="True" Unit="%" Value="{Binding WidgetScalePercent}"/>
                        <UniformGrid Columns="3" Margin="0,13,0,16"><Button Margin="0,0,6,0" Content="80%  Slim" Command="{Binding SetScaleCommand}" CommandParameter="80" Style="{StaticResource StudioButton}"/><Button Margin="6,0" Content="100%  Standard" Command="{Binding SetScaleCommand}" CommandParameter="100" Style="{StaticResource StudioButton}"/><Button Margin="6,0,0,0" Content="125%  Large" Command="{Binding SetScaleCommand}" CommandParameter="125" Style="{StaticResource StudioButton}"/></UniformGrid>
                        <UniformGrid Columns="2">
                            <controls:StudioSettingField Margin="0,0,8,0" Header="Window width" Description="pixels" Text="{Binding WidgetWidth, StringFormat={}{0:F0}}"/>
                            <controls:StudioSettingField Margin="8,0,0,0" Header="Window height" Description="pixels" Text="{Binding WidgetHeight, StringFormat={}{0:F0}}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Providers">
        <ScrollViewer>
            <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="SAMPLING" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Update frequency" Style="{StaticResource SectionTitleText}"/><TextBlock Margin="0,5,0,14" Text="The UI refresh rate. Providers keep independent non-overlapping schedules." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding UpdateRates}" SelectedItem="{Binding UpdateRate}" AutomationProperties.Name="Update frequency"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Performance policy" Style="{StaticResource SectionTitleText}"/><TextBlock Margin="0,5,0,14" Text="Efficiency reduces wakeups. Performance prioritizes fresher data." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding PerformanceMode}" AutomationProperties.Name="Performance policy"/></StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="PROVIDER HEALTH" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Telemetry sources" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,5,0,12" Text="Test a source without changing its configuration or interrupting the widget." Style="{StaticResource CaptionText}"/>
                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><StackPanel Margin="0,6,0,0" Orientation="Horizontal"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="  ·  " Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Latency}" Style="{StaticResource CaptionText}"/><TextBlock Text="  ·  " Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Sensors}" Style="{StaticResource CaptionText}"/></StackPanel></StackPanel>
                                            <Button Grid.Column="2" Content="Run test" Command="{Binding DataContext.TestProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource StudioButton}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="OPTIONAL SENSORS" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sensor browser" Style="{StaticResource SectionTitleText}"/><TextBlock Margin="0,4,0,0" Text="Pin up to three additional readings per module. Mini remains curated." Style="{StaticResource CaptionText}"/></StackPanel><TextBox Grid.Column="1" Margin="14,0,8,0" Text="{Binding SensorSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter sensors" Style="{StaticResource StudioTextBox}"/><Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshSensorsCommand}" Style="{StaticResource StudioButton}"/></Grid>
                        <TextBlock Margin="0,12,0,7" Text="{Binding SensorCatalogStatus}" Style="{StaticResource CaptionText}"/>
                        <ListBox MaxHeight="390" ItemsSource="{Binding SensorCatalogView}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource SettingRow}" Padding="8,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><CheckBox Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding IsPinned}" AutomationProperties.Name="{Binding Name, StringFormat=Pin {0}}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Margin="0,2,0,0" Text="{Binding Hardware}" Style="{StaticResource CaptionText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.Accent}"/><TextBlock Text="{Binding SensorType}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}"/></StackPanel><TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding ModuleLabel}" VerticalAlignment="Center" Style="{StaticResource CaptionText}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="Page.Diagnostics">
        <ScrollViewer>
            <StackPanel Style="{StaticResource PageStack}">
                <TextBlock Text="HEALTH" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}" BorderBrush="#5548DCF9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Runtime health" Style="{StaticResource SectionTitleText}"/><TextBlock Margin="0,5,0,15" Text="Measured resource impact and configuration state." Style="{StaticResource BodyText}"/><StackPanel Orientation="Horizontal"><Border Style="{StaticResource TagBorder}" Margin="0,0,8,0"><TextBlock Text="{Binding ResourceCpu, StringFormat=CPU  {0}}" Foreground="{StaticResource Brush.Accent}"/></Border><Border Style="{StaticResource TagBorder}" Margin="0,0,8,0"><TextBlock Text="{Binding ResourceMemory, StringFormat=RAM  {0}}" Foreground="{StaticResource Brush.Blue}"/></Border><Border Style="{StaticResource TagBorder}"><TextBlock Text="{Binding ImpactLabel}" Foreground="{StaticResource Brush.Success}"/></Border></StackPanel></StackPanel><Button Grid.Column="1" Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"/></Grid>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="FILES" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Configuration paths" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Margin="0,14,0,4" Text="STUDIO DOCUMENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding SettingsPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,14,0,4" Text="SHARED RUNTIME DOCUMENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding RuntimeSettingsPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,14,0,4" Text="WIDGET EXECUTABLE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding WidgetExecutablePath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,22,0,9" Text="MAINTENANCE" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <controls:StudioSettingToggle Header="Use sample telemetry" Description="Animate the Studio canvas only; live widget telemetry is unchanged." IsChecked="{Binding DemoMetrics}"/>
                        <WrapPanel Margin="0,15,0,0"><Button Content="Reload settings" Command="{Binding ReloadCommand}" Style="{StaticResource StudioButton}" Margin="0,0,8,8"/><Button Content="{Binding WidgetActionLabel}" Command="{Binding OpenOrRestartWidgetCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource StudioButton}" Margin="0,0,8,8"/><Button Content="Restore defaults" Command="{Binding ResetDemoCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/></WrapPanel>
                        <TextBlock Margin="0,12,0,0" Text="Restore defaults resets Studio and widget presentation settings. It does not uninstall sensors or delete telemetry history." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    </StackPanel>
